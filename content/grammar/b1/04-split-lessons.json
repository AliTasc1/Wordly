    {
      "id": "b1-01-must-may-might",
      "level": "B1",
      "order": 1,
      "title": "must, may, might — zorunluluk ve ihtimal",
      "topic": "Modals of obligation, prohibition and possibility",
      "canDo": "Bir şeyin kesin, olası ya da yasak olduğunu ayırt ederek söyleyebilirim.",
      "covers": [
        "MD.must.AFF",
        "MD.may.AFF",
        "MD.might.AFF"
      ],
      "concept": {
        "summary": "must güçlü zorunluluk ve güçlü tahmin bildirir; may ve might ihtimal bildirir. En çok karıştırılan çift mustn't ile don't have to: birincisi yasak, ikincisi gereksizlik demektir. Kip fiiller -s almaz ve arkalarından to gelmez.",
        "formula": {
          "left": "must / may / might",
          "right": "+ yalın fiil"
        },
        "table": [
          {
            "form": "must",
            "be": "zorunluluk / güçlü tahmin",
            "example": "You must wear a helmet. He must be tired."
          },
          {
            "form": "mustn't",
            "be": "yasak",
            "example": "You mustn't smoke here."
          },
          {
            "form": "don't have to",
            "be": "gerek yok",
            "example": "You don't have to come."
          },
          {
            "form": "may / might",
            "be": "ihtimal",
            "example": "It may rain later."
          }
        ]
      },
      "examples": [
        {
          "en": "All passengers must show their tickets.",
          "tr": "Tüm yolcular biletlerini göstermek zorunda.",
          "note": "Kural bildiren zorunluluk."
        },
        {
          "en": "You mustn't park in front of the gate.",
          "tr": "Kapının önüne park etmek yasak.",
          "note": "mustn't = yasak."
        },
        {
          "en": "You don't have to finish it today.",
          "tr": "Bugün bitirmen gerekmiyor.",
          "note": "Gereksizlik; yasak değil."
        },
        {
          "en": "She might call us tonight.",
          "tr": "Bu akşam bizi arayabilir.",
          "note": "İhtimal."
        },
        {
          "en": "He must be at home; his car is outside.",
          "tr": "Evde olmalı, arabası dışarıda.",
          "note": "Kanıta dayalı güçlü tahmin."
        }
      ],
      "mistakes": [
        {
          "wrong": "You mustn't come if you are busy.",
          "right": "You don't have to come if you are busy.",
          "why": "Gereksizlik mustn't ile değil don't have to ile anlatılır."
        },
        {
          "wrong": "She musts wear a uniform.",
          "right": "She must wear a uniform.",
          "why": "Kip fiiller -s almaz."
        },
        {
          "wrong": "It might to rain.",
          "right": "It might rain.",
          "why": "Kip fiilden sonra to gelmez."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "Visitors ___ sign in at reception.",
          "options": [
            "must",
            "musts",
            "must to",
            "are must"
          ],
          "answer": 0,
          "note": "Kural → must + yalın fiil."
        },
        {
          "type": "choice",
          "text": "You ___ touch the wires — it's dangerous.",
          "options": [
            "mustn't",
            "don't have to",
            "needn't",
            "may not to"
          ],
          "answer": 0,
          "note": "Yasak → mustn't."
        },
        {
          "type": "choice",
          "text": "It's Saturday, so you ___ get up early.",
          "options": [
            "don't have to",
            "mustn't",
            "can't",
            "shouldn't to"
          ],
          "answer": 0,
          "note": "Gerek yok → don't have to."
        },
        {
          "type": "gap",
          "text": "Take an umbrella; it ___ rain.",
          "options": [
            "might",
            "mights",
            "might to"
          ],
          "answer": 0,
          "note": "İhtimal → might."
        },
        {
          "type": "choice",
          "text": "You look pale. You ___ be ill.",
          "options": [
            "must",
            "can",
            "would",
            "should to"
          ],
          "answer": 0,
          "note": "Güçlü çıkarım → must be."
        },
        {
          "type": "choice",
          "text": "Take an umbrella. It ___ rain later.",
          "options": [
            "might",
            "must",
            "should not",
            "would"
          ],
          "answer": 0,
          "note": "İhtimal → might."
        },
        {
          "type": "choice",
          "text": "That ___ be true. I saw him here an hour ago.",
          "options": [
            "cannot",
            "must not",
            "may not",
            "should not"
          ],
          "answer": 0,
          "note": "İmkânsız çıkarım → cannot be."
        },
        {
          "type": "gap",
          "text": "She ___ still be at work; her car is outside.",
          "options": [
            "may",
            "must not",
            "cannot"
          ],
          "answer": 0,
          "note": "Zayıf ihtimal → may."
        },
        {
          "type": "choice",
          "text": "Passengers ___ show their tickets at the gate.",
          "options": [
            "must",
            "might",
            "may not",
            "would"
          ],
          "answer": 0,
          "note": "Kural → must."
        },
        {
          "type": "choice",
          "text": "The lights are on, so somebody ___ be inside.",
          "options": [
            "must",
            "musts",
            "must to",
            "is must"
          ],
          "answer": 0,
          "note": "Kanıta dayalı tahmin → must be."
        }
      ]
