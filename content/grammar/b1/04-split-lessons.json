    {
      "id": "b1-02-shouldnt-neednt",
      "level": "B1",
      "order": 2,
      "title": "shouldn't ve needn't — yapma ve gerek yok",
      "topic": "Negative advice and lack of necessity",
      "canDo": "Bir şeyi yapmamayı önerebilir, bir şeyin gerekli olmadığını söyleyebilirim.",
      "covers": [
        "MD.should.NEG",
        "MD.need.NEG"
      ],
      "concept": {
        "summary": "shouldn't tavsiyenin olumsuzudur: iyi bir fikir değil demektir, yasak demez. needn't ise gereksizliği bildirir: yapabilirsin ama gerekmiyor. İkisi de kiptir, arkalarından yalın fiil gelir ve -s almazlar. needn't yerine don't need to da kullanılabilir; anlam aynıdır, ikincisi daha yaygındır.",
        "formula": {
          "left": "shouldn't + yalın fiil",
          "right": "needn't / don't need to + yalın fiil"
        },
        "table": [
          {
            "form": "olumsuz tavsiye",
            "be": "shouldn't",
            "example": "You shouldn't eat so late."
          },
          {
            "form": "gereksizlik",
            "be": "needn't",
            "example": "You needn't wait for me."
          },
          {
            "form": "aynı anlam",
            "be": "don't need to",
            "example": "You don't need to wait."
          },
          {
            "form": "yasak değil",
            "be": "mustn't ile karıştırma",
            "example": "mustn't = yasak"
          }
        ]
      },
      "examples": [
        {
          "en": "You shouldn't drive when you are this tired.",
          "tr": "Bu kadar yorgunken araba kullanmamalısın.",
          "note": "Tavsiye, yasak değil."
        },
        {
          "en": "You needn't bring anything to the party.",
          "tr": "Partiye bir şey getirmene gerek yok.",
          "note": "Gereksizlik."
        },
        {
          "en": "We shouldn't leave the windows open at night.",
          "tr": "Geceleri pencereleri açık bırakmamalıyız.",
          "note": "shouldn't + yalın fiil."
        },
        {
          "en": "You don't need to print the ticket; the phone is enough.",
          "tr": "Bileti yazdırmana gerek yok, telefon yeterli.",
          "note": "needn't ile aynı anlam."
        },
        {
          "en": "She needn't worry about the interview.",
          "tr": "Görüşme için endişelenmesine gerek yok.",
          "note": "Kip olduğu için -s almaz."
        }
      ],
      "mistakes": [
        {
          "wrong": "You shouldn't to eat so late.",
          "right": "You shouldn't eat so late.",
          "why": "Kip fiilden sonra to gelmez."
        },
        {
          "wrong": "She needn'ts wait.",
          "right": "She needn't wait.",
          "why": "Kip fiiller -s almaz."
        },
        {
          "wrong": "You needn't smoke here; it is forbidden.",
          "right": "You mustn't smoke here; it is forbidden.",
          "why": "Yasak needn't ile değil mustn't ile anlatılır."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "You ___ worry, everything is ready.",
