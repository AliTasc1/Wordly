            "example": "There used to be a cinema here."
          },
          {
            "form": "olumsuz",
            "be": "didn't use to",
            "example": "I didn't use to like it."
          },
          {
            "form": "soru",
            "be": "Did you use to …?",
            "example": "Did you use to live here?"
