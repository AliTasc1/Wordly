    {
      "id": "b1-03-could-able-to",
      "level": "B1",
      "order": 3,
      "title": "could ve was able to — geçmişte yapabilmek",
      "topic": "Past ability",
      "canDo": "Eskiden neler yapabildiğimi, neyi tek seferde başardığımı ayırt ederek anlatabilirim.",
      "covers": [
        "MD.could.AFF",
        "MD.could.NEG",
        "MD.be_able_to.AFF"
      ],
      "concept": {
        "summary": "could geçmişteki genel yeteneği anlatır: yıllarca süren bir beceriyi. Belirli bir anda, bir zorluğu aşarak elde edilen tek seferlik başarıda could kullanılmaz; yerini was able to alır. Olumsuzda bu ayrım kalkar: couldn't her iki durumda da kullanılabilir.",
        "formula": {
          "left": "could + yalın fiil (genel)",
          "right": "was / were able to (tek sefer)"
        },
        "table": [
          {
            "form": "genel yetenek",
            "be": "could",
            "example": "I could swim at five."
          },
          {
            "form": "tek seferlik başarı",
            "be": "was able to",
            "example": "I was able to fix it yesterday."
          },
          {
            "form": "olumsuz",
            "be": "couldn't",
            "example": "I couldn't drive then."
          },
          {
            "form": "soru",
            "be": "Were you able to …?",
            "example": "Were you able to read it?"
          }
        ]
      },
      "examples": [
        {
          "en": "She could read before school.",
          "tr": "Okuldan önce okuyabiliyordu.",
          "note": "Genel yetenek."
        },
        {
          "en": "After two hours we were able to open the door.",
          "tr": "İki saat sonra kapıyı açabildik.",
          "note": "Tek seferlik başarı → was/were able to."
