            "shouldn't",
            "shouldn't to",
            "not should",
            "doesn't should"
          ],
          "answer": 0,
          "note": "Olumsuz tavsiye → shouldn't."
        },
        {
          "type": "choice",
          "text": "We ___ to book a table; the restaurant is never full.",
          "options": [
            "don't need",
            "needn't",
            "not need",
            "doesn't need"
          ],
          "answer": 0,
          "note": "don't need + to + fiil."
        },
        {
          "type": "gap",
          "text": "He ___ tell her before the meeting.",
          "options": [
            "shouldn't",
            "shouldn't to",
            "not should"
          ],
          "answer": 0,
          "note": "shouldn't + yalın fiil."
        },
        {
          "type": "choice",
          "text": "You ___ come in early tomorrow; the office opens at ten.",
          "options": [
            "needn't",
            "mustn't",
            "shouldn't have",
            "needn't to"
          ],
          "answer": 0,
          "note": "Gereksizlik → needn't."
        },
        {
