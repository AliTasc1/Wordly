{
  "_meta": {
    "batch": "b1-01",
    "level": "B1",
    "range": "Ders 1-5 — kip fiiller, olumsuzluk, past perfect, ikinci tip koşul"
  },
  "lessons": [
    {
      "id": "b1-05-negatives",
      "level": "B1",
      "order": 5,
      "title": "Olumsuzluk — tüm zamanlarda tek kural",
      "topic": "Negation across tenses",
      "canDo": "Öğrendiğim her zamanı olumsuz kurabilirim.",
      "covers": [
        "TA.PRESENT.does.NEG",
        "TA.PRPRG.NEG",
        "TA.PRPF.NEG",
        "TA.FUT.NEG",
        "MD.will.NEG",
        "IMP.V.NEG"
      ],
      "concept": {
        "summary": "İngilizcede olumsuzluk her zamanda aynı işler: not, yardımcı fiilin hemen arkasına gelir. Yardımcı fiil yoksa do getirilir. Bu tek kural bilinince yeni bir zaman için ayrı olumsuz kalıp ezberlemeye gerek kalmaz.",
        "formula": {
          "left": "yardımcı fiil + not",
          "right": "yardımcı yoksa do/does/did + not"
        },
        "table": [
          {
            "form": "geniş zaman",
            "be": "doesn't / don't",
            "example": "He doesn't drive."
          },
          {
            "form": "şimdiki",
            "be": "isn't / aren't + -ing",
            "example": "They aren't working."
          },
          {
            "form": "present perfect",
            "be": "hasn't / haven't + V3",
            "example": "I haven't seen it."
          },
          {
            "form": "gelecek",
            "be": "won't",
            "example": "She won't agree."
          },
          {
            "form": "emir",
            "be": "don't",
            "example": "Don't touch it."
          }
        ]
      },
      "examples": [
        {
          "en": "He doesn't work here any more.",
          "tr": "Artık burada çalışmıyor.",
          "note": "Geniş zaman, üçüncü tekil."
        },
        {
          "en": "They aren't listening to me.",
          "tr": "Beni dinlemiyorlar.",
          "note": "be zaten yardımcı, not hemen arkasına geldi."
        },
        {
          "en": "I haven't finished the report yet.",
          "tr": "Raporu henüz bitirmedim.",
          "note": "yet olumsuzda cümle sonunda."
        },
        {
          "en": "We won't be late.",
          "tr": "Geç kalmayacağız.",
          "note": "will not → won't."
        },
        {
          "en": "Don't forget to lock the door.",
          "tr": "Kapıyı kilitlemeyi unutma.",
          "note": "Olumsuz emir."
        }
      ],
      "mistakes": [
        {
          "wrong": "He doesn't works here.",
          "right": "He doesn't work here.",
          "why": "-s yardımcı fiile geçti, asıl fiil yalın kalır."
        },
        {
          "wrong": "I not have finished.",
          "right": "I haven't finished.",
          "why": "not yardımcı fiilin arkasına gelir."
        },
        {
          "wrong": "They don't are listening.",
          "right": "They aren't listening.",
          "why": "be zaten yardımcıdır, do gerekmez."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "She ___ like spicy food.",
          "options": [
            "doesn't",
            "don't",
            "isn't",
            "hasn't"
          ],
          "answer": 0,
          "note": "Geniş zaman, üçüncü tekil."
        },
        {
          "type": "choice",
          "text": "We ___ watching the match right now.",
          "options": [
            "aren't",
            "don't",
            "haven't",
            "won't"
          ],
          "answer": 0,
          "note": "Şimdiki zaman → be + not."
        },
        {
          "type": "choice",
          "text": "I ___ heard from him since May.",
          "options": [
            "haven't",
            "didn't",
            "don't",
            "am not"
          ],
          "answer": 0,
          "note": "Present perfect → haven't + V3."
        },
        {
          "type": "choice",
          "text": "They ___ arrive before eight.",
          "options": [
            "won't",
            "don't will",
            "aren't will",
            "not will"
          ],
          "answer": 0,
          "note": "Gelecek → won't."
        },
        {
          "type": "gap",
          "text": "___ open the window, please.",
          "options": [
            "Don't",
            "Not",
            "Doesn't"
          ],
          "answer": 0,
          "note": "Olumsuz emir → Don't."
        },
        {
          "type": "choice",
          "text": "He has ___ finished the report yet.",
          "options": [
            "not",
            "no",
            "never not",
            "any"
          ],
          "answer": 0,
          "note": "Yardımcı fiilden sonra not."
        },
        {
          "type": "choice",
          "text": "There is ___ reason to worry.",
          "options": [
            "no",
            "not",
            "not any of",
            "none"
          ],
          "answer": 0,
          "note": "İsimden önce → no."
        },
        {
          "type": "choice",
          "text": "I ___ anybody at the party.",
          "options": [
            "did not know",
            "did not knew",
            "not knew",
            "knew not"
          ],
          "answer": 0,
          "note": "did not + yalın fiil."
        },
        {
          "type": "gap",
          "text": "She ___ going to apologize.",
          "options": [
            "is not",
            "does not",
            "not is"
          ],
          "answer": 0,
          "note": "be ile olumsuzluk be'den sonra."
        },
        {
          "type": "choice",
          "text": "We have ___ money left at all.",
          "options": [
            "no",
            "not",
            "any",
            "none of"
          ],
          "answer": 0,
          "note": "have + no + isim."
        }
      ]
    },
    {
      "id": "b1-06-past-perfect",
      "level": "B1",
      "order": 6,
      "title": "Past perfect — had done",
      "topic": "Past perfect",
      "canDo": "Geçmişteki iki olaydan hangisinin önce olduğunu belirtebilirim.",
      "covers": [
        "TA.PASTPF.AFF"
      ],
      "concept": {
        "summary": "Geçmişte anlatılan bir olaydan daha önce olmuş bir şeyi göstermek için kullanılır. Yani \"geçmişin geçmişi\"dir: önce olan had + V3, sonra olan past simple olur. Tek bir olay anlatılıyorsa gerekmez.",
        "formula": {
          "left": "had + fiilin üçüncü hâli",
          "right": "(daha önce olan)"
        },
        "table": [
          {
            "form": "önce olan",
            "be": "had + V3",
            "example": "The train had left."
          },
          {
            "form": "sonra olan",
            "be": "past simple",
            "example": "when we arrived"
          },
          {
            "form": "olumsuz",
            "be": "hadn't + V3",
            "example": "I hadn't seen it before."
          },
          {
            "form": "sık kullanılan",
            "be": "already, just, never",
            "example": "She had already gone."
          }
        ]
      },
      "examples": [
        {
          "en": "When we arrived, the film had started.",
          "tr": "Biz vardığımızda film başlamıştı.",
          "note": "Film önce başladı."
        },
        {
          "en": "He had never flown before that day.",
          "tr": "O güne kadar hiç uçmamıştı.",
          "note": "before + geçmiş nokta."
        },
        {
          "en": "She had already left when I called.",
          "tr": "Ben aradığımda çoktan gitmişti.",
          "note": "already ile sık kullanılır."
        },
        {
          "en": "I couldn't get in because I had lost my key.",
          "tr": "Anahtarımı kaybettiğim için giremedim.",
          "note": "Sebep önce olmuş."
        },
        {
          "en": "They had finished dinner by eight.",
          "tr": "Sekize kadar yemeği bitirmişlerdi.",
          "note": "by + saat."
        }
      ],
      "mistakes": [
        {
          "wrong": "When we arrived, the film has started.",
          "right": "When we arrived, the film had started.",
          "why": "Geçmişin geçmişi için had gerekir."
        },
        {
          "wrong": "He had went home.",
          "right": "He had gone home.",
          "why": "had'den sonra üçüncü hâl gelir."
        },
        {
          "wrong": "Yesterday I had gone to the cinema.",
          "right": "Yesterday I went to the cinema.",
          "why": "Tek bir geçmiş olayda past simple yeter."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "By the time I got there, everyone ___ .",
          "options": [
            "had left",
            "has left",
            "left had",
            "was left"
          ],
          "answer": 0,
          "note": "Önce olan → had + V3."
        },
        {
          "type": "choice",
          "text": "She ___ the book before she saw the film.",
          "options": [
            "had read",
            "has read",
            "reads",
            "was read"
          ],
          "answer": 0,
          "note": "Okuma önce oldu."
        },
        {
          "type": "choice",
          "text": "We ___ never been to Greece before last summer.",
          "options": [
            "had",
            "have",
            "did",
            "were"
          ],
          "answer": 0,
          "note": "Geçmiş bir noktadan öncesi."
        },
        {
          "type": "choice",
          "text": "He was tired because he ___ all night.",
          "options": [
            "had worked",
            "has worked",
            "works",
            "had work"
          ],
          "answer": 0,
          "note": "Sebep daha önce gerçekleşti."
        },
        {
          "type": "gap",
          "text": "The shop was closed; it ___ at six.",
          "options": [
            "had closed",
            "has closed",
            "closes"
          ],
          "answer": 0,
          "note": "Kapanma daha önce olmuş."
        },
        {
          "type": "choice",
          "text": "When we arrived, the film ___ already started.",
          "options": [
            "had",
            "has",
            "was",
            "did"
          ],
          "answer": 0,
          "note": "Daha önce olan iş → had + V3."
        },
        {
          "type": "choice",
          "text": "He told me that he ___ the keys.",
          "options": [
            "had lost",
            "has lost",
            "loses",
            "was losing"
          ],
          "answer": 0,
          "note": "Anlatımdan önceki iş → past perfect."
        },
        {
          "type": "choice",
          "text": "She could not get in because she ___ her card at home.",
          "options": [
            "had left",
            "left",
            "has left",
            "was leaving"
          ],
          "answer": 0,
          "note": "Önceki iş → had left."
        },
        {
          "type": "gap",
          "text": "By the time the guests came, we ___ everything.",
          "options": [
            "had prepared",
            "prepared",
            "have prepared"
          ],
          "answer": 0,
          "note": "by the time + past perfect."
        },
        {
          "type": "choice",
          "text": "I did not recognize her; she ___ her hair.",
          "options": [
            "had cut",
            "cuts",
            "has cut",
            "was cutting"
          ],
          "answer": 0,
          "note": "Tanımamadan önce olan iş."
        }
      ]
    },
    {
      "id": "b1-07-second-conditional",
      "level": "B1",
      "order": 7,
      "title": "İkinci tip koşul — if I had, I would",
      "topic": "Second conditional",
      "canDo": "Gerçek olmayan durumlar üzerine konuşabilir, hayal kurabilirim.",
      "covers": [
        "SUBJ.PAST.AFF"
      ],
      "concept": {
        "summary": "Gerçekleşmesi mümkün olmayan ya da uzak ihtimalli durumlar için kullanılır. Yapı şaşırtıcıdır: if'li cümlecikte geçmiş zaman biçimi kullanılır ama anlam şimdiye ya da geleceğe bakar. be fiili için resmî dilde her öznede were gelir.",
        "formula": {
          "left": "If + past simple",
          "right": ", would + yalın fiil"
        },
        "table": [
          {
            "form": "koşul",
            "be": "If I had …",
            "example": "If I had time, I would help."
          },
          {
            "form": "sonuç",
            "be": "would + yalın fiil",
            "example": "I would travel more."
          },
          {
            "form": "be",
            "be": "were (her özne)",
            "example": "If I were you, …"
          },
          {
            "form": "birinci tiple fark",
            "be": "mümkün ↔ hayali",
            "example": "If it rains (olabilir) / If it rained (hayali)"
          }
        ]
      },
      "examples": [
        {
          "en": "If I had more money, I would buy a house.",
          "tr": "Daha çok param olsa bir ev alırdım.",
          "note": "Şu an param yok."
        },
        {
          "en": "If I were you, I would apologise.",
          "tr": "Yerinde olsam özür dilerdim.",
          "note": "Tavsiye için en sık kullanılan kalıp."
        },
        {
          "en": "She would travel more if she had time.",
          "tr": "Vakti olsa daha çok seyahat ederdi.",
          "note": "Ana cümle önce gelince virgül yok."
        },
        {
          "en": "What would you do if you lost your passport?",
          "tr": "Pasaportunu kaybetsen ne yapardın?",
          "note": "Varsayımsal soru."
        },
        {
          "en": "If they knew the answer, they would tell us.",
          "tr": "Cevabı bilseler bize söylerlerdi.",
          "note": "Bilmiyorlar."
        }
      ],
      "mistakes": [
        {
          "wrong": "If I would have money, I would buy a house.",
          "right": "If I had money, I would buy a house.",
          "why": "would if'li cümlecikte kullanılmaz."
        },
        {
          "wrong": "If I was you, I would apologise.",
          "right": "If I were you, I would apologise.",
          "why": "Bu kalıpta her öznede were gelir."
        },
        {
          "wrong": "If she had time, she will travel more.",
          "right": "If she had time, she would travel more.",
          "why": "İkinci tipte sonuç would ile kurulur."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "If I ___ rich, I would help more people.",
          "options": [
            "were",
            "am",
            "will be",
            "would be"
          ],
          "answer": 0,
          "note": "Hayali durum → were."
        },
        {
          "type": "choice",
          "text": "If he studied harder, he ___ better marks.",
          "options": [
            "would get",
            "will get",
            "gets",
            "would got"
          ],
          "answer": 0,
          "note": "Sonuç → would + yalın fiil."
        },
        {
          "type": "choice",
          "text": "What ___ you say if she asked you?",
          "options": [
            "would",
            "will",
            "do",
            "did"
          ],
          "answer": 0,
          "note": "Varsayımsal soru → would."
        },
        {
          "type": "choice",
          "text": "If we ___ a car, we could visit them.",
          "options": [
            "had",
            "have",
            "would have",
            "will have"
          ],
          "answer": 0,
          "note": "if'li cümlecikte geçmiş biçim."
        },
        {
          "type": "gap",
          "text": "I would call her if I ___ her number.",
          "options": [
            "knew",
            "know",
            "would know"
          ],
          "answer": 0,
          "note": "İkinci tip koşul."
        },
        {
          "type": "choice",
          "text": "If I ___ more time, I would learn the guitar.",
          "options": [
            "had",
            "have",
            "would have",
            "will have"
          ],
          "answer": 0,
          "note": "if + geçmiş biçim."
        },
        {
          "type": "choice",
          "text": "If she were here, she ___ what to do.",
          "options": [
            "would know",
            "will know",
            "knows",
            "would knew"
          ],
          "answer": 0,
          "note": "Sonuç → would + yalın fiil."
        },
        {
          "type": "choice",
          "text": "What would you do if you ___ the lottery?",
          "options": [
            "won",
            "win",
            "would win",
            "will win"
          ],
          "answer": 0,
          "note": "if cümleciğinde geçmiş biçim."
        },
        {
          "type": "gap",
          "text": "If I ___ you, I would say nothing.",
          "options": [
            "were",
            "am",
            "would be"
          ],
          "answer": 0,
          "note": "Kalıp: If I were you."
        },
        {
          "type": "choice",
          "text": "We ___ move abroad if the children were older.",
          "options": [
            "might",
            "will",
            "can",
            "must"
          ],
          "answer": 0,
          "note": "Sonuçta would/could/might kullanılabilir."
        }
      ]
    }
  ]
}
