  "lessons": [
    {
      "id": "b1-01-must-may-might",
      "level": "B1",
      "order": 1,
      "title": "must, may, might",
      "topic": "Modals of obligation, prohibition and possibility",
      "canDo": "Bir şeyin kesin, olası ya da yasak olduğunu ayırt ederek söyleyebilirim.",
      "covers": [
        "MD.must.AFF",
        "MD.may.AFF",
        "MD.might.AFF",
        "MD.should.NEG",
        "MD.need.NEG"
      ],
      "concept": {
        "summary": "must güçlü zorunluluk ve güçlü tahmin bildirir; may ve might ihtimal bildirir. En çok karıştırılan çift mustn't ile don't have to: birincisi yasak, ikincisi gereksizlik demektir.",
        "formula": {
          "left": "must / may / might",
          "right": "+ yalın fiil"
        },
        "table": [
          {
            "form": "must",
            "be": "zorunluluk / güçlü tahmin",
            "example": "You must wear a helmet. He must be tired."
          },
          {
            "form": "mustn't",
            "be": "yasak",
            "example": "You mustn't smoke here."
          },
          {
            "form": "don't have to",
            "be": "gerek yok",
            "example": "You don't have to come."
          },
          {
            "form": "may / might",
            "be": "ihtimal",
            "example": "It may rain later."
          },
          {
            "form": "needn't",
            "be": "gerek yok",
            "example": "You needn't wait."
          }
        ]
      },
      "examples": [
        {
          "en": "All passengers must show their tickets.",
          "tr": "Tüm yolcular biletlerini göstermek zorunda.",
          "note": "Kural bildiren zorunluluk."
        },
        {
          "en": "You mustn't park in front of the gate.",
          "tr": "Kapının önüne park etmek yasak.",
          "note": "mustn't = yasak."
        },
        {
          "en": "You don't have to finish it today.",
          "tr": "Bugün bitirmen gerekmiyor.",
          "note": "Gereksizlik; yasak değil."
        },
        {
          "en": "She might call us tonight.",
          "tr": "Bu akşam bizi arayabilir.",
          "note": "İhtimal."
        },
        {
          "en": "He must be at home; his car is outside.",
          "tr": "Evde olmalı, arabası dışarıda.",
          "note": "Kanıta dayalı güçlü tahmin."
        }
      ],
      "mistakes": [
        {
          "wrong": "You mustn't come if you are busy.",
          "right": "You don't have to come if you are busy.",
          "why": "Gereksizlik mustn't ile değil don't have to ile anlatılır."
        },
        {
          "wrong": "She musts wear a uniform.",
          "right": "She must wear a uniform.",
          "why": "Kip fiiller -s almaz."
        },
        {
          "wrong": "It might to rain.",
          "right": "It might rain.",
          "why": "Kip fiilden sonra to gelmez."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "Visitors ___ sign in at reception.",
          "options": [
            "must",
            "musts",
            "must to",
            "are must"
          ],
          "answer": 0,
          "note": "Kural → must + yalın fiil."
        },
        {
          "type": "choice",
          "text": "You ___ touch the wires — it's dangerous.",
          "options": [
            "mustn't",
            "don't have to",
            "needn't",
            "may not to"
          ],
          "answer": 0,
          "note": "Yasak → mustn't."
        },
        {
          "type": "choice",
          "text": "It's Saturday, so you ___ get up early.",
          "options": [
            "don't have to",
            "mustn't",
            "can't",
            "shouldn't to"
          ],
          "answer": 0,
          "note": "Gerek yok → don't have to."
        },
        {
          "type": "choice",
          "text": "Take an umbrella; it ___ rain.",
          "options": [
            "might",
            "mights",
            "might to",
            "is might"
          ],
          "answer": 0,
          "note": "İhtimal → might."
        },
        {
          "type": "gap",
          "text": "You ___ worry, everything is ready.",
          "options": [
            "needn't",
            "mustn't to",
            "don't need"
          ],
          "answer": 0,
          "note": "needn't + yalın fiil."
        },
        {
          "type": "choice",
          "text": "You look pale. You ___ be ill.",
          "options": [
            "must",
            "can",
            "would",
            "should to"
          ],
          "answer": 0,
          "note": "Güçlü çıkarım → must be."
        },
        {
          "type": "choice",
          "text": "Take an umbrella. It ___ rain later.",
          "options": [
            "might",
            "must",
            "should not",
            "would"
          ],
          "answer": 0,
          "note": "İhtimal → might."
        },
        {
          "type": "choice",
          "text": "That ___ be true. I saw him here an hour ago.",
          "options": [
            "cannot",
            "must not",
            "may not",
            "should not"
          ],
          "answer": 0,
          "note": "İmkânsız çıkarım → cannot be."
        },
        {
          "type": "gap",
          "text": "She ___ still be at work; her car is outside.",
          "options": [
            "may",
            "must not",
            "cannot"
          ],
          "answer": 0,
          "note": "Zayıf ihtimal → may."
        },
        {
          "type": "choice",
          "text": "Passengers ___ show their tickets at the gate.",
          "options": [
            "must",
            "might",
            "may not",
            "would"
          ],
          "answer": 0,
          "note": "Kural → must."
        }
      ]
    },
    {
      "id": "b1-02-could-able-used-to",
      "level": "B1",
      "order": 2,
      "title": "could, be able to, used to",
      "topic": "Past ability and past habits",
      "canDo": "Eskiden neler yapabildiğimi ve nelere alışkın olduğumu anlatabilirim.",
      "covers": [
        "MD.could.AFF",
        "MD.could.NEG",
        "MD.be_able_to.AFF",
        "MD.used_to.AFF"
      ],
      "concept": {
        "summary": "could geçmişteki genel yeteneği anlatır. Tek seferlik bir başarıda could yerine was able to kullanılır. used to ise artık yapmadığımız eski alışkanlıkları anlatır ve yalnızca geçmişte kullanılır.",
        "formula": {
          "left": "could / was able to",
          "right": "used to + yalın fiil"
        },
        "table": [
          {
            "form": "genel yetenek",
            "be": "could",
            "example": "I could swim at five."
          },
          {
            "form": "tek seferlik başarı",
            "be": "was able to",
            "example": "I was able to fix it yesterday."
          },
          {
            "form": "eski alışkanlık",
            "be": "used to",
            "example": "We used to live in Bursa."
          },
          {
            "form": "olumsuz",
            "be": "couldn't / didn't use to",
            "example": "I couldn't drive then."
          }
        ]
      },
      "examples": [
        {
          "en": "She could read before school.",
          "tr": "Okuldan önce okuyabiliyordu.",
          "note": "Genel yetenek."
        },
        {
          "en": "After two hours we were able to open the door.",
          "tr": "İki saat sonra kapıyı açabildik.",
          "note": "Tek seferlik başarı → was/were able to."
        },
        {
          "en": "I used to smoke, but I stopped.",
          "tr": "Eskiden sigara içerdim ama bıraktım.",
          "note": "Artık yapılmayan alışkanlık."
        },
        {
          "en": "He couldn't come because he was ill.",
          "tr": "Hasta olduğu için gelemedi.",
          "note": "could'un olumsuzu."
        },
        {
          "en": "There used to be a cinema here.",
          "tr": "Eskiden burada bir sinema vardı.",
          "note": "Geçmişteki durum."
        }
      ],
      "mistakes": [
        {
          "wrong": "Yesterday I could finally fix the car.",
          "right": "Yesterday I was able to fix the car.",
          "why": "Tek seferlik başarıda could kullanılmaz."
        },
        {
          "wrong": "I use to smoke.",
          "right": "I used to smoke.",
          "why": "Kalıp geçmiş biçimdedir: used to."
        },
        {
          "wrong": "I used to go there next year.",
          "right": "I used to go there.",
          "why": "used to yalnızca geçmiş içindir."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "When I was a child, I ___ play the piano.",
          "options": [
            "could",
            "can",
            "was can",
            "could to"
          ],
          "answer": 0,
          "note": "Geçmiş genel yetenek."
        },
        {
          "type": "choice",
          "text": "The room was locked, but we ___ get in through the window.",
          "options": [
            "were able to",
            "could",
            "can",
            "are able"
          ],
          "answer": 0,
          "note": "Tek seferlik başarı."
        },
        {
          "type": "choice",
          "text": "She ___ have long hair.",
          "options": [
            "used to",
            "use to",
            "used",
            "is used to"
          ],
          "answer": 0,
          "note": "Eski durum → used to."
        },
        {
          "type": "choice",
          "text": "I ___ understand a word he said.",
          "options": [
            "couldn't",
            "could not to",
            "can't",
            "wasn't could"
          ],
          "answer": 0,
          "note": "Geçmişte yeteneğin yokluğu."
        },
        {
          "type": "gap",
          "text": "There ___ be a market on this street.",
          "options": [
            "used to",
            "use to",
            "uses to"
          ],
          "answer": 0,
          "note": "used to + yalın fiil."
        },
        {
          "type": "choice",
          "text": "When I was a child, I ___ swim very well.",
          "options": [
            "could",
            "can",
            "was able",
            "used"
          ],
          "answer": 0,
          "note": "Geçmişte genel yetenek → could."
        },
        {
          "type": "choice",
          "text": "The road was closed, but we ___ to find another way.",
          "options": [
            "were able",
            "could",
            "can",
            "used"
          ],
          "answer": 0,
          "note": "Tek seferlik başarı → was/were able to."
        },
        {
          "type": "choice",
          "text": "She ___ live in Adana before she moved here.",
          "options": [
            "used to",
            "use to",
            "is used to",
            "used"
          ],
          "answer": 0,
          "note": "Geçmiş alışkanlık → used to + yalın fiil."
        },
        {
          "type": "gap",
          "text": "I did not ___ to like coffee, but now I drink it every day.",
          "options": [
            "use",
            "used",
            "using"
          ],
          "answer": 0,
          "note": "Olumsuzda did + use to."
        },
        {
          "type": "choice",
          "text": "___ you able to read the sign from there?",
          "options": [
            "Were",
            "Did",
            "Could you were",
            "Are used"
          ],
          "answer": 0,
          "note": "be able to sorusu be ile kurulur."
        }
      ]
    },
    {
      "id": "b1-03-negatives",
      "level": "B1",
      "order": 3,
      "title": "Olumsuzluk — tüm zamanlarda tek kural",
      "topic": "Negation across tenses",
      "canDo": "Öğrendiğim her zamanı olumsuz kurabilirim.",
      "covers": [
        "TA.PRESENT.does.NEG",
        "TA.PRPRG.NEG",
        "TA.PRPF.NEG",
        "TA.FUT.NEG",
        "MD.will.NEG",
        "IMP.V.NEG"
      ],
      "concept": {
        "summary": "İngilizcede olumsuzluk her zamanda aynı işler: not, yardımcı fiilin hemen arkasına gelir. Yardımcı fiil yoksa do getirilir. Bu tek kural bilinince yeni bir zaman için ayrı olumsuz kalıp ezberlemeye gerek kalmaz.",
        "formula": {
          "left": "yardımcı fiil + not",
          "right": "yardımcı yoksa do/does/did + not"
        },
        "table": [
          {
            "form": "geniş zaman",
            "be": "doesn't / don't",
            "example": "He doesn't drive."
          },
          {
            "form": "şimdiki",
            "be": "isn't / aren't + -ing",
            "example": "They aren't working."
          },
          {
            "form": "present perfect",
            "be": "hasn't / haven't + V3",
            "example": "I haven't seen it."
          },
          {
            "form": "gelecek",
            "be": "won't",
            "example": "She won't agree."
          },
          {
            "form": "emir",
            "be": "don't",
            "example": "Don't touch it."
          }
        ]
      },
      "examples": [
        {
          "en": "He doesn't work here any more.",
          "tr": "Artık burada çalışmıyor.",
          "note": "Geniş zaman, üçüncü tekil."
        },
        {
          "en": "They aren't listening to me.",
          "tr": "Beni dinlemiyorlar.",
          "note": "be zaten yardımcı, not hemen arkasına geldi."
        },
        {
          "en": "I haven't finished the report yet.",
          "tr": "Raporu henüz bitirmedim.",
          "note": "yet olumsuzda cümle sonunda."
        },
        {
          "en": "We won't be late.",
          "tr": "Geç kalmayacağız.",
          "note": "will not → won't."
        },
        {
          "en": "Don't forget to lock the door.",
          "tr": "Kapıyı kilitlemeyi unutma.",
          "note": "Olumsuz emir."
        }
      ],
      "mistakes": [
        {
          "wrong": "He doesn't works here.",
          "right": "He doesn't work here.",
          "why": "-s yardımcı fiile geçti, asıl fiil yalın kalır."
        },
        {
          "wrong": "I not have finished.",
          "right": "I haven't finished.",
          "why": "not yardımcı fiilin arkasına gelir."
        },
        {
          "wrong": "They don't are listening.",
          "right": "They aren't listening.",
          "why": "be zaten yardımcıdır, do gerekmez."
        }
      ],
      "exercises": [
