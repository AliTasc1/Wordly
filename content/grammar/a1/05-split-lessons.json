    {
      "id": "a1-16-wh-questions-why-how",
      "level": "A1",
      "order": 16,
      "title": "Why, How, How old — sebep ve ölçü",
      "topic": "Wh- questions: why, how, how + adjective",
      "canDo": "Bir şeyin neden ve nasıl olduğunu, ne kadar olduğunu sorabilirim.",
      "covers": [
        "INT.why",
        "INT.how",
        "INT.how_JJ.RB"
      ],
      "concept": {
        "summary": "Why sebep, How yol ya da durum sorar. How'un arkasına bir sıfat ya da zarf eklenirse ölçü sorusu olur: How old, How far, How much, How many, How often. Bu kalıpta How ile sıfat birbirinden ayrılmaz, ikisi birlikte başa gelir. Geri kalan düzen normal soru düzenidir.",
        "formula": {
          "left": "Why / How + do / be",
          "right": "How + sıfat + be + özne?"
        },
        "table": [
          {
            "form": "Why",
            "be": "neden",
            "example": "Why are you late?"
          },
          {
            "form": "How",
            "be": "nasıl",
            "example": "How do you go to work?"
          },
          {
            "form": "How old",
            "be": "kaç yaşında",
            "example": "How old are you?"
          },
          {
            "form": "How much / many",
            "be": "ne kadar / kaç tane",
            "example": "How much is this?"
          }
        ]
      },
      "examples": [
        {
          "en": "Why is the shop closed?",
          "tr": "Dükkân neden kapalı?",
          "note": "be soruya taşınır."
        },
        {
          "en": "How much is this?",
          "tr": "Bu ne kadar?",
          "note": "How much fiyat sorar."
        },
        {
          "en": "How far is the station?",
          "tr": "İstasyon ne kadar uzakta?",
          "note": "How + sıfat kalıbı."
        },
        {
          "en": "How do you spell your surname?",
          "tr": "Soyadını nasıl yazıyorsun?",
          "note": "How ile yol sorusu."
        },
        {
          "en": "Why do you want this job?",
          "tr": "Bu işi neden istiyorsun?",
          "note": "Asıl fiilde do gerekir."
        }
      ],
      "mistakes": [
        {
          "wrong": "How old you are?",
          "right": "How old are you?",
          "why": "be öznenin önüne geçer."
        },
        {
          "wrong": "Why you are late?",
          "right": "Why are you late?",
          "why": "Soru düzeni wh- kelimesinden sonra da korunur."
        },
        {
          "wrong": "How much are this book?",
          "right": "How much is this book?",
          "why": "book tekil → is."
        }
      ],
      "exercises": [
