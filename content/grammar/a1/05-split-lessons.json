    {
      "id": "a1-20-conjunctions-and-but-or",
      "level": "A1",
      "order": 20,
      "title": "and, but, or — iki eşit parçayı birleştirmek",
      "topic": "Coordinating conjunctions",
      "canDo": "İki fikri, iki nesneyi ya da iki seçeneği tek cümlede birleştirebilirim.",
      "covers": [
        "CC"
      ],
      "concept": {
        "summary": "and, but ve or iki eşit parçayı birleştirir: iki kelime, iki öbek ya da iki cümle. and ekler, but karşıtlık kurar, or seçenek sunar. İki cümleyi yalnızca virgülle birleştirmek yetmez; aralarına bağlaç girmelidir.",
        "formula": {
          "left": "parça + and / but / or",
          "right": "+ parça"
        },
        "table": [
          {
            "form": "and",
            "be": "ekleme",
            "example": "I called and left a message."
          },
          {
            "form": "but",
            "be": "karşıtlık",
            "example": "It is small but comfortable."
          },
          {
            "form": "or",
            "be": "seçenek",
            "example": "Tea or coffee?"
          },
          {
            "form": "virgül",
            "be": "tek başına yetmez",
            "example": "not: I like tea, I like coffee."
          }
        ]
      },
      "examples": [
        {
          "en": "I like tea and coffee.",
          "tr": "Çayı da kahveyi de severim.",
          "note": "and iki nesneyi birleştirir."
        },
        {
          "en": "The room is small but clean.",
          "tr": "Oda küçük ama temiz.",
          "note": "but karşıtlık kurar."
