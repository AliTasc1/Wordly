          "text": "What ___ she do at weekends?",
          "options": [
            "does",
            "do",
            "is",
            "are"
          ],
          "answer": 0,
          "note": "she → does."
        },
        {
          "type": "choice",
          "text": "___ is your birthday?",
          "options": [
            "When",
            "What",
            "Who",
            "How"
          ],
          "answer": 0,
          "note": "Zaman → When."
        },
        {
          "type": "gap",
          "text": "___ do you live?",
          "options": [
            "Where",
            "What",
            "Who"
          ],
          "answer": 0,
          "note": "Yer → Where."
        },
        {
          "type": "choice",
          "text": "___ is in the box?",
          "options": [
            "What",
            "Where",
            "When",
            "How"
          ],
          "answer": 0,
