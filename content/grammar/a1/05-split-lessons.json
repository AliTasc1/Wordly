  "lessons": [
    {
      "id": "a1-02-be-negative",
      "level": "A1",
      "order": 2,
      "title": "\"to be\" — değil demek",
      "topic": "Present simple: be (negative)",
      "canDo": "Bir şeyin öyle olmadığını söyleyebilirim.",
      "covers": [
        "PP.I_am_not",
        "TA.PRESENT.be.NEG"
      ],
      "concept": {
        "summary": "be cümlesinde olumsuzluk için be'den sonra not eklenir. Ayrı bir yardımcı fiil (do) gerekmez — be zaten kendi işini görür. Konuşmada kısaltma kullanılır: isn't, aren't. I am not'ın kısaltması I'm not'tır; \"amn't\" diye bir biçim yoktur.",
        "formula": {
          "left": "Özne + be + not",
          "right": "isn't / aren't / I'm not"
        },
        "table": [
          {
            "form": "I",
            "be": "I am not",
            "example": "I am not tired."
          },
          {
            "form": "he / she / it",
            "be": "is not → isn't",
            "example": "She isn't here."
          },
          {
            "form": "we / you / they",
            "be": "are not → aren't",
            "example": "We aren't late."
          },
          {
            "form": "yanlış",
            "be": "amn't yoktur",
            "example": "not: I amn't tired."
          }
        ]
      },
      "examples": [
        {
          "en": "I am not tired.",
          "tr": "Yorgun değilim.",
          "note": "I am not'ın kısaltması I'm not'tır; \"amn't\" yoktur."
        },
        {
          "en": "She isn't here.",
          "tr": "O burada değil.",
          "note": "is not → isn't."
        },
        {
          "en": "We aren't late.",
          "tr": "Geç kalmadık.",
          "note": "are not → aren't."
        },
        {
          "en": "The shop isn't open on Sunday.",
          "tr": "Dükkân pazar günü açık değil.",
          "note": "Tekil özne → isn't."
        },
        {
          "en": "They aren't at home this week.",
          "tr": "Bu hafta evde değiller.",
          "note": "Çoğul özne → aren't."
        }
      ],
      "mistakes": [
        {
          "wrong": "I not tired.",
          "right": "I am not tired.",
          "why": "not tek başına olumsuzluk yapmaz, be ile gelir."
        },
        {
          "wrong": "She doesn't here.",
          "right": "She isn't here.",
          "why": "be cümlesinde do kullanılmaz."
        },
        {
          "wrong": "I amn't ready.",
          "right": "I am not ready.",
          "why": "am not'ın kısaltması yoktur."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "She ___ my teacher. (olumsuz)",
          "options": [
            "isn't",
            "aren't",
            "not is",
            "doesn't"
          ],
          "answer": 0,
          "note": "she → is not → isn't."
        },
        {
          "type": "choice",
          "text": "I ___ hungry.",
          "options": [
            "am not",
            "not am",
            "isn't",
            "don't"
          ],
          "answer": 0,
          "note": "I am not; \"amn't\" diye bir biçim yok."
        },
        {
          "type": "gap",
          "text": "We ___ from the same city. (olumsuz)",
          "options": [
            "aren't",
            "isn't",
            "am not"
          ],
          "answer": 0,
          "note": "we → are not → aren't."
        },
        {
          "type": "choice",
          "text": "She ___ not here today.",
          "options": [
            "is",
            "are",
            "am",
            "be"
          ],
          "answer": 0,
          "note": "she → is not."
        },
        {
          "type": "gap",
          "text": "We ___ not ready yet.",
          "options": [
            "are",
            "is",
            "am"
          ],
          "answer": 0,
          "note": "we → are not."
        },
        {
          "type": "choice",
          "text": "The children ___ in the garden now.",
          "options": [
            "aren't",
            "isn't",
            "am not",
            "don't"
          ],
          "answer": 0,
          "note": "Çoğul özne → aren't."
        },
        {
          "type": "choice",
          "text": "This coffee ___ very hot.",
          "options": [
            "isn't",
            "aren't",
            "am not",
            "doesn't"
          ],
          "answer": 0,
          "note": "Tekil özne → isn't."
        },
        {
          "type": "gap",
          "text": "I ___ from Ankara.",
          "options": [
            "am not",
            "not am",
            "isn't"
          ],
          "answer": 0,
          "note": "I → am not."
        },
        {
          "type": "choice",
          "text": "My parents ___ at work today.",
          "options": [
            "aren't",
            "isn't",
            "am not",
            "don't"
          ],
          "answer": 0,
          "note": "parents çoğul → aren't."
        },
        {
          "type": "choice",
          "text": "It ___ cold in here.",
          "options": [
            "isn't",
            "aren't",
            "am not",
            "doesn't"
          ],
          "answer": 0,
          "note": "it → isn't."
        }
      ]
    },
    {
      "id": "a1-03-be-questions",
      "level": "A1",
      "order": 3,
      "title": "Are you …? — \"to be\" ile soru",
      "topic": "Present simple: be (interrogative)",
      "canDo": "be fiiliyle basit sorular sorabilirim.",
      "covers": [
        "PP.are_you",
        "TA.PRESENT.be.INT.AFF"
      ],
      "concept": {
        "summary": "be cümlesinde soru, be'yi öznenin önüne alarak kurulur. Başka bir yardımcı fiil eklenmez; do burada kullanılmaz. Yazıda yalnızca soru işareti koymak yetmez, kelime sırası da değişmelidir. Kısa cevapta be tekrarlanır: Yes, I am. / No, she isn't.",
        "formula": {
          "left": "Be + özne + …?",
          "right": "Yes, I am. / No, she isn't."
        },
        "table": [
          {
            "form": "I",
            "be": "Am I …?",
            "example": "Am I late?"
          },
          {
            "form": "he / she / it",
            "be": "Is he …?",
            "example": "Is she a nurse?"
          },
          {
            "form": "we / you / they",
            "be": "Are you …?",
            "example": "Are you a student?"
          },
          {
            "form": "kısa cevap",
            "be": "Yes, … am / is / are",
            "example": "Yes, I am."
          }
        ]
      },
      "examples": [
        {
          "en": "Are you okay?",
          "tr": "İyi misin?",
          "note": "Soruda are başa geçer."
        },
        {
          "en": "Is your sister a nurse?",
          "tr": "Ablan hemşire mi?",
          "note": "Özne uzun olsa da is en başta kalır."
        },
        {
          "en": "Am I in the right room?",
          "tr": "Doğru odada mıyım?",
          "note": "I ile Am."
        },
        {
          "en": "Are they ready to leave?",
          "tr": "Gitmeye hazırlar mı?",
          "note": "Çoğul özne → Are."
        },
        {
          "en": "Is it far from here?",
          "tr": "Buradan uzak mı?",
          "note": "it → Is."
        }
      ],
      "mistakes": [
        {
          "wrong": "You are a doctor?",
          "right": "Are you a doctor?",
          "why": "Yazıda soru, be'yi başa almakla kurulur; sadece soru işareti yetmez."
        },
        {
          "wrong": "Do you a student?",
          "right": "Are you a student?",
          "why": "be cümlesinde do kullanılmaz."
        },
        {
          "wrong": "Is your sister and her friend here?",
          "right": "Are your sister and her friend here?",
          "why": "İki kişi çoğuldur → Are."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "___ they at school?",
          "options": [
            "Are",
            "Is",
            "Am",
            "Do"
          ],
          "answer": 0,
          "note": "they → are, soruda başa geçer."
        },
        {
          "type": "choice",
          "text": "___ this your bag?",
          "options": [
            "Is",
            "Are",
            "Am",
            "Does"
          ],
          "answer": 0,
          "note": "this tekil → is."
        },
        {
          "type": "choice",
          "text": "___ you a student?",
          "options": [
            "Are",
            "Is",
            "Am",
            "Be"
          ],
          "answer": 0,
          "note": "you → Are."
        },
        {
          "type": "gap",
          "text": "___ your father a doctor?",
          "options": [
            "Is",
            "Are",
            "Am"
          ],
          "answer": 0,
          "note": "Tekil özne → Is."
        },
        {
          "type": "choice",
          "text": "___ I late?",
          "options": [
            "Am",
            "Is",
            "Are",
            "Do"
          ],
          "answer": 0,
          "note": "I → Am."
        },
        {
          "type": "choice",
          "text": "___ the shops open today?",
          "options": [
            "Are",
            "Is",
            "Am",
            "Do"
          ],
          "answer": 0,
          "note": "shops çoğul → Are."
        },
        {
          "type": "choice",
          "text": "___ it far from the station?",
          "options": [
            "Is",
            "Are",
            "Am",
            "Does"
          ],
          "answer": 0,
          "note": "it → Is."
        },
        {
          "type": "gap",
          "text": "___ we in the right queue?",
          "options": [
            "Are",
            "Is",
            "Am"
          ],
          "answer": 0,
          "note": "we → Are."
        },
        {
          "type": "choice",
          "text": "Are you tired? — Yes, ___ .",
          "options": [
            "I am",
            "I do",
            "am I",
            "I are"
          ],
          "answer": 0,
          "note": "Kısa cevapta be tekrarlanır."
        },
        {
          "type": "choice",
          "text": "Is she your sister? — No, ___ .",
          "options": [
            "she isn't",
            "she doesn't",
            "isn't she",
            "she not is"
          ],
          "answer": 0,
          "note": "Olumsuz kısa cevap: No, she isn't."
        }
      ]
    },
    {
      "id": "a1-15-wh-questions-what-where",
      "level": "A1",
      "order": 15,
      "title": "What, Where, When — bilgi sorma",
      "topic": "Wh- questions: what, where",
      "canDo": "Bir şeyin ne olduğunu, nerede ve ne zaman olduğunu sorabilirim.",
      "covers": [
        "INT.what",
        "INT.where"
      ],
      "concept": {
        "summary": "Soru kelimesi en başa gelir, arkasından normal soru düzeni gelir: yardımcı fiil, sonra özne. Yani wh- kelimesi eklenince soru yapısı bozulmaz, sadece başına bir kelime alır. be cümlesinde be özneden önce gelir; asıl fiilde do ya da does gerekir.",
        "formula": {
          "left": "Wh- + do / does / be",
          "right": "+ özne + fiil?"
        },
        "table": [
          {
            "form": "What",
            "be": "ne",
            "example": "What do you want?"
          },
          {
            "form": "Where",
            "be": "nerede",
            "example": "Where does she live?"
          },
          {
            "form": "When",
            "be": "ne zaman",
            "example": "When is the meeting?"
          },
          {
            "form": "be ile",
            "be": "be öne geçer",
            "example": "What is your name?"
          }
        ]
      },
      "examples": [
        {
          "en": "What is your name?",
          "tr": "Adın ne?",
          "note": "be cümlesinde be özneden önce."
        },
        {
          "en": "Where do you live?",
          "tr": "Nerede yaşıyorsun?",
          "note": "Asıl fiilde do gerekir."
        },
        {
          "en": "When does the film start?",
          "tr": "Film ne zaman başlıyor?",
          "note": "3. tekil → does."
        },
        {
          "en": "What do you do at the weekend?",
          "tr": "Hafta sonu ne yaparsın?",
          "note": "İlk do yardımcı, ikinci do asıl fiil."
        },
        {
          "en": "Where is the nearest bank?",
          "tr": "En yakın banka nerede?",
          "note": "be ile yer sorusu."
        }
      ],
      "mistakes": [
        {
          "wrong": "Where you live?",
          "right": "Where do you live?",
          "why": "Soru kelimesi yardımcı fiili ortadan kaldırmaz."
        },
        {
          "wrong": "What means this word?",
          "right": "What does this word mean?",
          "why": "Özne ile fiilin yeri değişmez, do eklenir."
        },
        {
          "wrong": "When the film starts?",
          "right": "When does the film start?",
          "why": "Asıl fiilli soruda does gerekir."
        }
      ],
      "exercises": [
