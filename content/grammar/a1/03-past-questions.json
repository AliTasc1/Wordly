    {
      "id": "a1-14-wh-questions",
      "level": "A1",
      "order": 14,
      "title": "What, Where, Why, How",
      "topic": "Wh- questions",
      "canDo": "Bilgi sorabilir, bir şeyin nerede, ne zaman ve neden olduğunu öğrenebilirim.",
      "covers": [
        "INT.what",
        "INT.where",
        "INT.why",
        "INT.how",
        "INT.how_JJ.RB"
      ],
      "concept": {
        "summary": "Soru kelimesi en başa gelir, arkasından normal soru düzeni gelir: yardımcı fiil, sonra özne. Yani wh- kelimesi eklenince soru yapısı bozulmaz, sadece başına bir kelime alır.",
        "formula": {
          "left": "Wh- + do/does/be",
          "right": "+ özne + fiil?"
        },
        "table": [
          {
            "form": "What",
            "be": "ne",
            "example": "What do you want?"
          },
          {
            "form": "Where",
            "be": "nerede",
            "example": "Where does she live?"
          },
          {
            "form": "Why",
            "be": "neden",
            "example": "Why are you late?"
          },
          {
            "form": "How",
            "be": "nasıl",
            "example": "How do you go to work?"
          },
          {
            "form": "How + sıfat",
            "be": "ne kadar",
            "example": "How old are you?"
          }
        ]
      },
      "examples": [
        {
          "en": "What is your name?",
          "tr": "Adın ne?",
          "note": "be cümlesinde be özneden önce."
        },
        {
          "en": "Where do you live?",
          "tr": "Nerede yaşıyorsun?",
          "note": "Asıl fiilde do gerekir."
        },
        {
          "en": "Why is the shop closed?",
          "tr": "Dükkân neden kapalı?",
          "note": "be soruya taşınır."
        },
        {
          "en": "How much is this?",
          "tr": "Bu ne kadar?",
          "note": "How much fiyat sorar."
        },
        {
          "en": "How far is the station?",
          "tr": "İstasyon ne kadar uzakta?",
          "note": "How + sıfat kalıbı."
        }
      ],
      "mistakes": [
        {
          "wrong": "Where you live?",
          "right": "Where do you live?",
          "why": "Soru kelimesi yardımcı fiili ortadan kaldırmaz."
        },
        {
          "wrong": "What means this word?",
          "right": "What does this word mean?",
          "why": "Özne ile fiilin yeri değişmez, do eklenir."
        },
        {
          "wrong": "How old you are?",
          "right": "How old are you?",
          "why": "be öznenin önüne geçer."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "___ do you work?",
          "options": [
            "Where",
            "What",
            "Who",
            "How much"
          ],
          "answer": 0,
          "note": "Yer soruluyor → Where."
        },
        {
          "type": "choice",
          "text": "Why ___ you angry?",
          "options": [
            "are",
            "do",
            "does",
            "is"
          ],
          "answer": 0,
          "note": "you → are."
        },
        {
          "type": "choice",
          "text": "___ does this bag cost?",
          "options": [
            "How much",
            "How many",
            "What many",
            "How old"
          ],
          "answer": 0,
          "note": "Fiyat → How much."
        },
        {
          "type": "choice",
          "text": "What ___ she do at weekends?",
          "options": [
            "does",
            "do",
            "is",
            "are"
          ],
          "answer": 0,
          "note": "she → does."
        },
        {
          "type": "gap",
          "text": "___ old is your brother?",
          "options": [
            "How",
            "What",
            "Why"
          ],
          "answer": 0,
          "note": "Yaş → How old."
        },
        {
          "type": "choice",
          "text": "___ is your birthday?",
          "options": [
            "When",
            "What",
            "Who",
            "How"
          ],
          "answer": 0,
          "note": "Zaman → When."
        },
        {
          "type": "choice",
          "text": "___ do you live?",
          "options": [
            "Where",
            "What",
            "Who",
            "When"
          ],
          "answer": 0,
          "note": "Yer → Where."
        },
        {
          "type": "choice",
          "text": "___ old is this building?",
          "options": [
            "How",
            "What",
            "Which",
            "Who"
          ],
          "answer": 0,
          "note": "Yaş → How old."
        },
        {
          "type": "gap",
          "text": "___ is that man over there?",
          "options": [
            "Who",
            "Where",
            "When"
          ],
          "answer": 0,
          "note": "Kişi → Who."
        },
        {
          "type": "choice",
          "text": "___ are you sad?",
          "options": [
            "Why",
            "Who",
            "Where",
            "Which"
          ],
          "answer": 0,
          "note": "Sebep → Why."
        }
      ]
    },
    {
      "id": "a1-15-past-simple",
      "level": "A1",
      "order": 15,
      "title": "Geçmiş zaman — was, were, -ed",
      "topic": "Past simple: be and lexical verbs",
      "canDo": "Dün ne yaptığımı ve nerede olduğumu anlatabilirim.",
      "covers": [
        "TA.PAST.be.AFF",
        "TA.PAST.do.AFF"
      ],
      "concept": {
        "summary": "Bitmiş bir iş için kullanılır. be fiilinin geçmişi was ve were'dür. Diğer fiillerde sona -ed eklenir, ama sık kullanılan fiillerin çoğu düzensizdir ve ezberlenir.",
        "formula": {
          "left": "was / were",
          "right": "fiil + -ed (ya da düzensiz biçim)"
        },
        "table": [
          {
            "form": "I / he / she / it",
            "be": "was",
            "example": "I was at home."
          },
          {
            "form": "you / we / they",
            "be": "were",
            "example": "They were happy."
          },
          {
            "form": "düzenli",
            "be": "+ed",
            "example": "work → worked"
          },
          {
            "form": "düzensiz",
            "be": "biçim değişir",
            "example": "go → went, see → saw"
          }
        ]
      },
      "examples": [
        {
          "en": "I was at work yesterday.",
          "tr": "Dün işteydim.",
          "note": "I → was."
        },
        {
          "en": "They were very tired.",
          "tr": "Çok yorgunlardı.",
          "note": "they → were."
        },
        {
          "en": "We watched a film last night.",
          "tr": "Dün gece bir film izledik.",
          "note": "Düzenli fiil → -ed."
        },
        {
          "en": "She went to Ankara on Monday.",
          "tr": "Pazartesi Ankara'ya gitti.",
          "note": "go'nun geçmişi went."
        },
        {
          "en": "He bought a new phone.",
          "tr": "Yeni bir telefon aldı.",
          "note": "buy → bought."
        }
      ],
      "mistakes": [
        {
          "wrong": "They was late.",
          "right": "They were late.",
          "why": "Çoğul özne were alır."
        },
        {
          "wrong": "She goed home.",
          "right": "She went home.",
          "why": "go düzensizdir, -ed almaz."
        },
        {
          "wrong": "I was went there.",
          "right": "I went there.",
          "why": "İki geçmiş zaman üst üste gelmez."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "We ___ at the cinema last night.",
          "options": [
            "were",
            "was",
            "are",
            "did"
          ],
          "answer": 0,
          "note": "we → were."
        },
        {
          "type": "choice",
          "text": "He ___ his homework yesterday.",
          "options": [
            "finished",
            "finish",
            "finishes",
            "was finish"
          ],
          "answer": 0,
          "note": "Düzenli fiil → -ed."
        },
        {
          "type": "choice",
          "text": "I ___ my keys this morning.",
          "options": [
            "lost",
            "losed",
            "lose",
            "was lose"
          ],
          "answer": 0,
          "note": "lose → lost."
        },
        {
          "type": "choice",
          "text": "The weather ___ terrible on Sunday.",
          "options": [
            "was",
            "were",
            "is",
            "did"
          ],
          "answer": 0,
          "note": "weather = it → was."
        },
        {
          "type": "gap",
          "text": "They ___ to Antalya last summer.",
          "options": [
            "went",
            "goed",
            "go"
          ],
          "answer": 0,
          "note": "go → went."
        },
        {
          "type": "choice",
          "text": "I ___ at home yesterday.",
          "options": [
            "was",
            "were",
            "am",
            "is"
          ],
          "answer": 0,
          "note": "I → was."
        },
        {
          "type": "choice",
          "text": "They ___ to Izmir last summer.",
          "options": [
            "went",
            "go",
            "goes",
            "gone"
          ],
          "answer": 0,
          "note": "go fiilinin 2. hâli → went."
        },
        {
          "type": "choice",
          "text": "She ___ a new coat last week.",
          "options": [
            "bought",
            "buys",
            "buy",
            "buyed"
          ],
          "answer": 0,
          "note": "buy düzensiz → bought."
        },
        {
          "type": "gap",
          "text": "We ___ very tired after the trip.",
          "options": [
            "were",
            "was",
            "are"
          ],
          "answer": 0,
          "note": "we → were."
        },
        {
          "type": "choice",
          "text": "He ___ the film on Saturday.",
          "options": [
            "watched",
            "watch",
            "watches",
