  "lessons": [
    {
      "id": "a1-14-imperative",
      "level": "A1",
      "order": 14,
      "title": "Emir kipi ve let's",
      "topic": "Imperative and let's",
      "canDo": "Yol tarif edebilir, birine ne yapacağını söyleyebilir, birlikte bir şey önerebilirim.",
      "covers": [
        "IMP.V.AFF",
        "IMP.let's_V.AFF"
      ],
      "concept": {
        "summary": "Emir kipi İngilizcenin en kısa cümlesidir: özne yazılmaz, fiil yalın hâlde başa gelir. Olumsuzu don't ile, \"hadi\" anlamındaki ortak öneri let's ile kurulur.",
        "formula": {
          "left": "Yalın fiil + ...",
          "right": "Don't / Let's + yalın fiil"
        },
        "table": [
          {
            "form": "olumlu",
            "be": "fiil",
            "example": "Open the door."
          },
          {
            "form": "olumsuz",
            "be": "don't + fiil",
            "example": "Don't touch that."
          },
          {
            "form": "öneri",
            "be": "let's + fiil",
            "example": "Let's go home."
          },
          {
            "form": "nazik",
            "be": "please",
            "example": "Please sit down."
          }
        ]
      },
      "examples": [
        {
          "en": "Turn left at the corner.",
          "tr": "Köşeden sola dön.",
          "note": "Yol tarifi emir kipiyle verilir."
        },
        {
          "en": "Don't worry.",
          "tr": "Merak etme.",
          "note": "Olumsuzda don't."
        },
        {
          "en": "Let's take a taxi.",
          "tr": "Hadi taksiye binelim.",
          "note": "Konuşan da işin içinde."
        },
        {
          "en": "Please close the window.",
          "tr": "Lütfen pencereyi kapat.",
          "note": "please cümlenin başına da sonuna da gelebilir."
        },
        {
          "en": "Call me tomorrow.",
          "tr": "Yarın beni ara.",
          "note": "Özne (you) söylenmez."
        }
      ],
      "mistakes": [
        {
          "wrong": "You open the door.",
          "right": "Open the door.",
          "why": "Emir kipinde özne yazılmaz."
        },
        {
          "wrong": "Not touch that.",
          "right": "Don't touch that.",
          "why": "Olumsuz emir don't ile kurulur."
        },
        {
          "wrong": "Let's to go home.",
          "right": "Let's go home.",
          "why": "let's'ten sonra yalın fiil gelir."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "___ the salt, please.",
          "options": [
            "Pass",
            "You pass",
            "To pass",
            "Passing"
          ],
          "answer": 0,
          "note": "Emir kipi yalın fiille başlar."
        },
        {
          "type": "choice",
          "text": "___ be late again.",
          "options": [
            "Don't",
            "Not",
            "No",
            "Doesn't"
          ],
          "answer": 0,
          "note": "Olumsuz emir → Don't."
        },
        {
          "type": "choice",
          "text": "___ meet at seven.",
          "options": [
            "Let's",
            "Let us to",
            "Lets to",
            "Let"
          ],
          "answer": 0,
          "note": "Ortak öneri → Let's + yalın fiil."
        },
        {
          "type": "choice",
          "text": "___ your seatbelt.",
          "options": [
            "Fasten",
            "Fastens",
            "To fasten",
            "Fastening"
          ],
          "answer": 0,
          "note": "Yalın fiil."
        },
        {
          "type": "gap",
          "text": "___ forget your keys.",
          "options": [
            "Don't",
            "Not",
            "No"
          ],
          "answer": 0,
          "note": "Olumsuz emir."
        },
        {
          "type": "choice",
          "text": "___ the door, please.",
          "options": [
            "Close",
            "Closes",
            "Closing",
            "To close"
          ],
          "answer": 0,
          "note": "Emir → yalın fiil."
        },
        {
          "type": "choice",
          "text": "___ not touch that.",
          "options": [
            "Do",
            "Does",
            "Are",
            "Is"
          ],
          "answer": 0,
          "note": "Olumsuz emir → Do not."
        },
        {
          "type": "choice",
          "text": "___ go to the beach tomorrow.",
          "options": [
            "Let's",
            "Let",
            "Lets us",
            "We let"
          ],
          "answer": 0,
          "note": "Birlikte öneri → Let's."
        },
        {
          "type": "gap",
          "text": "___ quiet in the library.",
          "options": [
            "Be",
            "Are",
            "Is"
          ],
          "answer": 0,
          "note": "be fiilinin emir hâli → Be."
        },
        {
          "type": "choice",
          "text": "Please ___ me tonight.",
          "options": [
            "call",
            "calls",
            "calling",
            "to call"
          ],
          "answer": 0,
          "note": "Emir → yalın fiil."
        }
      ]
    },
    {
      "id": "a1-17-past-simple",
      "level": "A1",
      "order": 17,
      "title": "Geçmiş zaman — was, were, -ed",
      "topic": "Past simple: be and lexical verbs",
      "canDo": "Dün ne yaptığımı ve nerede olduğumu anlatabilirim.",
      "covers": [
        "TA.PAST.be.AFF",
        "TA.PAST.do.AFF"
      ],
      "concept": {
        "summary": "Bitmiş bir iş için kullanılır. be fiilinin geçmişi was ve were'dür. Diğer fiillerde sona -ed eklenir, ama sık kullanılan fiillerin çoğu düzensizdir ve ezberlenir.",
        "formula": {
          "left": "was / were",
          "right": "fiil + -ed (ya da düzensiz biçim)"
        },
        "table": [
          {
            "form": "I / he / she / it",
            "be": "was",
            "example": "I was at home."
          },
          {
            "form": "you / we / they",
            "be": "were",
            "example": "They were happy."
          },
          {
            "form": "düzenli",
            "be": "+ed",
            "example": "work → worked"
          },
          {
            "form": "düzensiz",
            "be": "biçim değişir",
            "example": "go → went, see → saw"
          }
        ]
      },
      "examples": [
        {
          "en": "I was at work yesterday.",
          "tr": "Dün işteydim.",
          "note": "I → was."
        },
        {
          "en": "They were very tired.",
          "tr": "Çok yorgunlardı.",
          "note": "they → were."
        },
        {
          "en": "We watched a film last night.",
          "tr": "Dün gece bir film izledik.",
          "note": "Düzenli fiil → -ed."
        },
        {
          "en": "She went to Ankara on Monday.",
          "tr": "Pazartesi Ankara'ya gitti.",
          "note": "go'nun geçmişi went."
        },
        {
          "en": "He bought a new phone.",
          "tr": "Yeni bir telefon aldı.",
          "note": "buy → bought."
        }
      ],
      "mistakes": [
        {
          "wrong": "They was late.",
          "right": "They were late.",
          "why": "Çoğul özne were alır."
        },
        {
          "wrong": "She goed home.",
          "right": "She went home.",
          "why": "go düzensizdir, -ed almaz."
        },
        {
          "wrong": "I was went there.",
          "right": "I went there.",
          "why": "İki geçmiş zaman üst üste gelmez."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "We ___ at the cinema last night.",
          "options": [
            "were",
            "was",
            "are",
            "did"
          ],
          "answer": 0,
          "note": "we → were."
        },
        {
          "type": "choice",
          "text": "He ___ his homework yesterday.",
          "options": [
            "finished",
            "finish",
            "finishes",
            "was finish"
          ],
          "answer": 0,
          "note": "Düzenli fiil → -ed."
        },
        {
          "type": "choice",
          "text": "I ___ my keys this morning.",
          "options": [
            "lost",
            "losed",
            "lose",
            "was lose"
          ],
          "answer": 0,
          "note": "lose → lost."
        },
        {
          "type": "choice",
          "text": "The weather ___ terrible on Sunday.",
          "options": [
            "was",
            "were",
            "is",
            "did"
          ],
          "answer": 0,
          "note": "weather = it → was."
        },
        {
          "type": "gap",
          "text": "They ___ to Antalya last summer.",
          "options": [
            "went",
            "goed",
            "go"
          ],
          "answer": 0,
          "note": "go → went."
        },
        {
          "type": "choice",
          "text": "I ___ at home yesterday.",
          "options": [
            "was",
            "were",
            "am",
            "is"
          ],
          "answer": 0,
          "note": "I → was."
        },
        {
          "type": "choice",
          "text": "They ___ to Izmir last summer.",
          "options": [
            "went",
            "go",
            "goes",
            "gone"
          ],
          "answer": 0,
          "note": "go fiilinin 2. hâli → went."
        },
        {
          "type": "choice",
          "text": "She ___ a new coat last week.",
          "options": [
            "bought",
            "buys",
            "buy",
            "buyed"
          ],
          "answer": 0,
          "note": "buy düzensiz → bought."
        },
        {
          "type": "gap",
          "text": "We ___ very tired after the trip.",
          "options": [
            "were",
            "was",
            "are"
          ],
          "answer": 0,
          "note": "we → were."
        },
        {
          "type": "choice",
          "text": "He ___ the film on Saturday.",
          "options": [
            "watched",
            "watch",
            "watches",
            "watching"
          ],
          "answer": 0,
          "note": "Düzenli fiil → -ed."
        }
      ]
    },
    {
      "id": "a1-18-comparatives",
      "level": "A1",
      "order": 18,
      "title": "Karşılaştırma: -er ve -est",
      "topic": "Comparative and superlative: -er / -est",
      "canDo": "İki şeyi karşılaştırabilir, bir grubun en iyisini söyleyebilirim.",
      "covers": [
        "COMP.JJR.RBR.er",
        "COMP.JJS.RBS.est"
      ],
      "concept": {
        "summary": "Kısa sıfatlarda karşılaştırma ek ile yapılır: -er daha, -est en demektir. -er'den sonra than, -est'ten önce the gelir.",
        "formula": {
          "left": "sıfat-er + than",
          "right": "the + sıfat-est"
        },
        "table": [
          {
            "form": "tek heceli",
            "be": "+er / +est",
            "example": "old → older → the oldest"
          },
          {
            "form": "sessiz e",
            "be": "+r / +st",
            "example": "large → larger → the largest"
          },
          {
            "form": "ünsüz + y",
            "be": "y → ier / iest",
            "example": "easy → easier → the easiest"
          },
          {
            "form": "düzensiz",
            "be": "biçim değişir",
            "example": "good → better → the best"
          }
        ]
      },
      "examples": [
        {
          "en": "My brother is taller than me.",
          "tr": "Kardeşim benden uzun.",
          "note": "-er'den sonra than."
        },
        {
          "en": "This is the cheapest hotel in town.",
          "tr": "Bu, şehirdeki en ucuz otel.",
          "note": "-est'ten önce the."
        },
        {
          "en": "Today is hotter than yesterday.",
          "tr": "Bugün dünden sıcak.",
          "note": "Tek heceli sıfatta son ünsüz ikizleşir."
        },
        {
          "en": "She is the best student in the class.",
          "tr": "Sınıftaki en iyi öğrenci o.",
          "note": "good → the best."
        },
        {
          "en": "The second book was easier.",
          "tr": "İkinci kitap daha kolaydı.",
          "note": "easy → easier."
        }
      ],
      "mistakes": [
        {
          "wrong": "He is more tall than me.",
          "right": "He is taller than me.",
          "why": "Kısa sıfatta more değil -er kullanılır."
        },
        {
          "wrong": "This is cheapest hotel.",
          "right": "This is the cheapest hotel.",
          "why": "En üstünlük derecesi the ister."
        },
        {
          "wrong": "She is taller from me.",
          "right": "She is taller than me.",
          "why": "Karşılaştırma than ile kurulur."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "Winter is ___ than autumn.",
          "options": [
            "colder",
            "more cold",
            "coldest",
            "the colder"
          ],
          "answer": 0,
          "note": "Tek heceli sıfat → -er."
        },
        {
          "type": "choice",
          "text": "This is ___ day of the year.",
          "options": [
            "the longest",
            "longest",
            "longer",
            "more long"
          ],
          "answer": 0,
          "note": "En üstünlük → the + -est."
        },
        {
          "type": "choice",
          "text": "My new phone is ___ than the old one.",
          "options": [
            "faster",
            "more fast",
            "fastest",
            "fast"
          ],
          "answer": 0,
          "note": "Karşılaştırma → -er + than."
        },
        {
          "type": "choice",
          "text": "That was ___ film of the year.",
          "options": [
            "the worst",
            "the baddest",
            "worse",
            "the worse"
          ],
          "answer": 0,
          "note": "bad → the worst; A1'de henüz görülmemiş bir zaman kullanmamak için cümle yalın tutuldu."
        },
        {
          "type": "gap",
          "text": "This exercise is ___ than the first one.",
          "options": [
            "easier",
            "easyer",
            "more easy"
          ],
          "answer": 0,
          "note": "y → ier."
        },
        {
          "type": "choice",
          "text": "My bag is ___ than yours.",
          "options": [
            "heavier",
            "heavy",
            "heaviest",
            "more heavy"
          ],
          "answer": 0,
          "note": "İki heceli -y → -ier."
        },
        {
          "type": "choice",
          "text": "This is the ___ day of the year.",
          "options": [
            "longest",
            "longer",
            "long",
            "most long"
          ],
          "answer": 0,
          "note": "En üstünlük → the -est."
        },
        {
          "type": "choice",
          "text": "Ali is ___ than his brother.",
          "options": [
            "taller",
            "tall",
            "tallest",
            "more tall"
          ],
          "answer": 0,
          "note": "Kısa sıfat → -er."
        },
        {
          "type": "gap",
          "text": "Today is ___ than yesterday.",
          "options": [
            "colder",
            "cold",
            "coldest"
          ],
          "answer": 0,
          "note": "than → karşılaştırma."
        },
        {
          "type": "choice",
          "text": "That was the ___ book in the shop.",
          "options": [
            "cheapest",
            "cheaper",
            "cheap",
            "more cheap"
          ],
          "answer": 0,
          "note": "the + -est."
        }
      ]
    },
    {
      "id": "a1-19-prepositions",
      "level": "A1",
      "order": 19,
      "title": "in, on, at — yer ve zaman",
      "topic": "Basic prepositions of place and time",
      "canDo": "Bir şeyin nerede ve ne zaman olduğunu söyleyebilirim.",
      "covers": [
        "IN.PREP.GENERAL"
      ],
      "concept": {
        "summary": "Türkçede tek bir -de eki bu üç edatın işini görür, o yüzden ayrımı ezberlemek gerekir. Genel kural: alan için in, yüzey için on, nokta için at.",
        "formula": {
          "left": "yer: in > on > at",
          "right": "zaman: in > on > at"
        },
        "table": [
          {
            "form": "in",
            "be": "geniş alan / uzun süre",
            "example": "in Turkey, in May, in the morning"
          },
          {
            "form": "on",
            "be": "yüzey / gün",
            "example": "on the table, on Monday"
          },
          {
            "form": "at",
            "be": "nokta / saat",
            "example": "at the door, at seven o'clock"
          },
          {
            "form": "istisna",
            "be": "at night",
            "example": "I work at night."
          }
        ]
      },
      "examples": [
        {
          "en": "The keys are on the table.",
          "tr": "Anahtarlar masanın üstünde.",
          "note": "Yüzey → on."
        },
        {
          "en": "She lives in Istanbul.",
          "tr": "İstanbul'da yaşıyor.",
          "note": "Şehir → in."
        },
        {
          "en": "We meet at the bus stop.",
          "tr": "Otobüs durağında buluşuyoruz.",
          "note": "Belirli nokta → at."
        },
        {
          "en": "My birthday is in July.",
          "tr": "Doğum günüm temmuzda.",
          "note": "Ay → in."
        },
        {
          "en": "The class starts at nine.",
          "tr": "Ders dokuzda başlıyor.",
          "note": "Saat → at."
        }
      ],
      "mistakes": [
        {
          "wrong": "I live at Istanbul.",
          "right": "I live in Istanbul.",
          "why": "Şehir bir alandır → in."
        },
        {
          "wrong": "See you in Monday.",
          "right": "See you on Monday.",
          "why": "Günlerde on kullanılır."
        },
        {
          "wrong": "The film starts in eight.",
          "right": "The film starts at eight.",
          "why": "Saatte at kullanılır."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "The cat is ___ the box.",
          "options": [
            "in",
            "on",
            "at",
            "to"
          ],
          "answer": 0,
          "note": "Kutunun içi → in."
        },
        {
          "type": "choice",
          "text": "We have a meeting ___ Friday.",
          "options": [
            "on",
            "in",
            "at",
            "to"
          ],
          "answer": 0,
          "note": "Gün → on."
        },
        {
          "type": "choice",
          "text": "I wake up ___ six o'clock.",
          "options": [
            "at",
            "in",
            "on",
            "by"
          ],
          "answer": 0,
          "note": "Saat → at."
        },
        {
          "type": "choice",
          "text": "She was born ___ 1998.",
          "options": [
            "in",
            "on",
            "at",
            "from"
          ],
          "answer": 0,
          "note": "Yıl → in."
        },
        {
          "type": "gap",
          "text": "Your book is ___ the shelf.",
          "options": [
            "on",
            "in",
            "at"
          ],
          "answer": 0,
          "note": "Raf bir yüzeydir → on."
        },
        {
          "type": "choice",
          "text": "The class starts ___ nine o'clock.",
          "options": [
            "at",
            "in",
            "on",
            "to"
          ],
          "answer": 0,
          "note": "Saat → at."
        },
        {
          "type": "choice",
          "text": "My birthday is ___ June.",
          "options": [
            "in",
            "on",
            "at",
            "to"
          ],
          "answer": 0,
          "note": "Ay → in."
        },
        {
          "type": "choice",
          "text": "We meet ___ Monday morning.",
          "options": [
            "on",
            "in",
            "at",
            "to"
          ],
          "answer": 0,
          "note": "Belirli gün → on."
        },
        {
          "type": "gap",
          "text": "The keys are ___ the table.",
          "options": [
            "on",
            "in",
            "at"
          ],
          "answer": 0,
          "note": "Yüzey üstü → on."
        },
        {
          "type": "choice",
          "text": "She lives ___ a small village.",
          "options": [
            "in",
            "on",
            "at",
            "to"
          ],
          "answer": 0,
