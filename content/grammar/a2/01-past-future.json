{
  "_meta": { "batch": "a2-01", "level": "A2", "range": "Ders 1-6 — geçmiş zaman olumsuz/soru, sürekli geçmiş, gelecek, be going to" },
  "lessons": [
    {
      "id": "a2-01-past-negative-question",
      "level": "A2",
      "order": 1,
      "title": "Geçmiş zaman — olumsuz ve soru",
      "topic": "Past simple: didn't / did",
      "canDo": "Dün yapmadığım şeyleri söyleyebilir, olanı biteni sorabilirim.",
      "covers": ["TA.PAST.be.NEG", "TA.PAST.do.NEG", "TA.PAST.do.INT.AFF", "VP.SVO.NEG"],
      "concept": {
        "summary": "Geçmişte olumsuzluk ve soru için did kullanılır. Geçmişlik did'e geçtiği için asıl fiil yalın hâle döner — ikinci kez geçmiş yapılmaz. be fiili ise kendi başına çalışır: wasn't, weren't.",
        "formula": { "left": "Özne + didn't + yalın fiil", "right": "Did + özne + yalın fiil?" },
        "table": [
          { "form": "olumsuz", "be": "didn't + yalın fiil", "example": "I didn't see him." },
          { "form": "soru", "be": "Did + özne + yalın fiil", "example": "Did you see him?" },
          { "form": "be olumsuz", "be": "wasn't / weren't", "example": "She wasn't at home." },
          { "form": "be soru", "be": "Was / Were + özne", "example": "Were they late?" }
        ]
      },
      "examples": [
        { "en": "I didn't go to work yesterday.", "tr": "Dün işe gitmedim.", "note": "went değil go — geçmişlik didn't'te." },
        { "en": "Did you call her?", "tr": "Onu aradın mı?", "note": "Soruda Did başa gelir." },
        { "en": "He wasn't ready.", "tr": "Hazır değildi.", "note": "be fiili did almaz." },
        { "en": "We didn't know the address.", "tr": "Adresi bilmiyorduk.", "note": "know yalın kaldı." },
        { "en": "Were you at the meeting?", "tr": "Toplantıda mıydın?", "note": "you → Were." }
      ],
      "mistakes": [
        { "wrong": "I didn't went there.", "right": "I didn't go there.", "why": "Geçmişlik bir cümlede iki kez gösterilmez." },
        { "wrong": "Did you saw the film?", "right": "Did you see the film?", "why": "Did'den sonra fiil yalın gelir." },
        { "wrong": "She didn't was at home.", "right": "She wasn't at home.", "why": "be fiiliyle did kullanılmaz." }
      ],
      "exercises": [
        { "type": "choice", "text": "They ___ the bus this morning.", "options": ["didn't catch", "didn't caught", "not caught", "weren't catch"], "answer": 0, "note": "didn't + yalın fiil." },
        { "type": "choice", "text": "___ she finish the report?", "options": ["Did", "Does", "Was", "Has"], "answer": 0, "note": "Geçmiş soru → Did." },
        { "type": "choice", "text": "The shops ___ open on Sunday.", "options": ["weren't", "wasn't", "didn't", "don't"], "answer": 0, "note": "shops çoğul be → weren't." },
        { "type": "choice", "text": "Did you ___ my message?", "options": ["get", "got", "getting", "gets"], "answer": 0, "note": "Did'den sonra yalın fiil." },
        { "type": "gap", "text": "I ___ anything about it.", "options": ["didn't know", "didn't knew", "not knew"], "answer": 0, "note": "didn't + yalın fiil." }
      ]
    },
    {
      "id": "a2-02-past-progressive",
      "level": "A2",
      "order": 2,
      "title": "Sürekli geçmiş — was doing",
      "topic": "Past progressive",
      "canDo": "Geçmişte bir anda ne yapmakta olduğumu anlatabilirim.",
      "covers": ["TA.PASTPRG.AFF"],
      "concept": {
        "summary": "Geçmişte bir noktada sürmekte olan iş için kullanılır. Genellikle araya giren kısa bir olayla birlikte gelir: uzun iş was/were + -ing, kısa olay past simple olur.",
        "formula": { "left": "was / were", "right": "+ fiil-ing" },
        "table": [
          { "form": "I / he / she / it", "be": "was + -ing", "example": "I was sleeping." },
          { "form": "you / we / they", "be": "were + -ing", "example": "They were working." },
          { "form": "araya girme", "be": "when + past simple", "example": "I was reading when he called." },
          { "form": "aynı anda", "be": "while", "example": "While she was cooking, I set the table." }
        ]
      },
      "examples": [
        { "en": "I was watching TV at nine.", "tr": "Dokuzda televizyon izliyordum.", "note": "Belirli bir anda süren iş." },
        { "en": "They were waiting for the bus.", "tr": "Otobüsü bekliyorlardı.", "note": "they → were." },
        { "en": "She was cooking when I arrived.", "tr": "Ben vardığımda yemek yapıyordu.", "note": "Uzun iş -ing, kısa olay past simple." },
        { "en": "It was raining all morning.", "tr": "Bütün sabah yağmur yağıyordu.", "note": "Süreklilik vurgulanıyor." },
        { "en": "While we were talking, the lights went out.", "tr": "Biz konuşurken ışıklar gitti.", "note": "while sürekli olanla kullanılır." }
      ],
      "mistakes": [
        { "wrong": "I was watch TV.", "right": "I was watching TV.", "why": "-ing eki düşmez." },
        { "wrong": "They was waiting.", "right": "They were waiting.", "why": "Çoğul özne were alır." },
        { "wrong": "When he called, I was read.", "right": "When he called, I was reading.", "why": "was/were her zaman -ing ile gelir." }
      ],
      "exercises": [
        { "type": "choice", "text": "At eight o'clock I ___ dinner.", "options": ["was having", "had having", "were having", "am having"], "answer": 0, "note": "I → was + -ing." },
        { "type": "choice", "text": "The children ___ in the garden.", "options": ["were playing", "was playing", "are played", "played were"], "answer": 0, "note": "Çoğul → were." },
        { "type": "choice", "text": "She ___ when the phone rang.", "options": ["was sleeping", "slept was", "is sleeping", "were sleeping"], "answer": 0, "note": "Uzun iş sürekli geçmişte." },
        { "type": "choice", "text": "While I ___ , it started to snow.", "options": ["was driving", "drove", "am driving", "were drove"], "answer": 0, "note": "while + sürekli geçmiş." },
        { "type": "gap", "text": "We ___ for you at the station.", "options": ["were waiting", "was waiting", "are waited"], "answer": 0, "note": "we → were + -ing." }
      ]
    },
    {
      "id": "a2-03-will",
      "level": "A2",
      "order": 3,
      "title": "will — gelecek",
      "topic": "Future: will",
      "canDo": "Gelecekle ilgili tahmin yapabilir, o anda karar verebilirim.",
      "covers": ["TA.FUT.AFF", "MD.will.AFF"],
      "concept": {
        "summary": "will tahmin, söz verme ve o anda alınan karar için kullanılır. Kip fiil olduğu için özneye göre değişmez ve ardından yalın fiil gelir.",
        "formula": { "left": "Özne + will", "right": "+ yalın fiil" },
        "table": [
          { "form": "olumlu", "be": "will / 'll", "example": "I will help you." },
          { "form": "olumsuz", "be": "won't", "example": "He won't come." },
          { "form": "soru", "be": "Will + özne", "example": "Will you be there?" },
          { "form": "tahmin", "be": "I think ... will", "example": "I think it will rain." }
        ]
      },
      "examples": [
        { "en": "I think she will like it.", "tr": "Bence bunu beğenecek.", "note": "Tahmin." },
        { "en": "I'll call you tonight.", "tr": "Bu akşam seni ararım.", "note": "Söz verme; will → 'll." },
        { "en": "He won't be late.", "tr": "Geç kalmayacak.", "note": "will not → won't." },
        { "en": "Will you help me with this?", "tr": "Bunda bana yardım eder misin?", "note": "Rica." },
        { "en": "The meeting will start at ten.", "tr": "Toplantı onda başlayacak.", "note": "Gelecekteki olay." }
      ],
      "mistakes": [
        { "wrong": "She wills come.", "right": "She will come.", "why": "Kip fiiller -s almaz." },
        { "wrong": "I will to help you.", "right": "I will help you.", "why": "will'den sonra to gelmez." },
        { "wrong": "He will not to be late.", "right": "He won't be late.", "why": "Olumsuzda will not / won't yeterlidir." }
      ],
      "exercises": [
        { "type": "choice", "text": "Don't worry, I ___ you.", "options": ["will help", "will helps", "will to help", "am help"], "answer": 0, "note": "will + yalın fiil." },
        { "type": "choice", "text": "I think it ___ tomorrow.", "options": ["will snow", "snows will", "will snows", "is snow"], "answer": 0, "note": "Tahminde will." },
        { "type": "choice", "text": "She ___ be at the office today.", "options": ["won't", "willn't", "doesn't will", "not will"], "answer": 0, "note": "will not → won't." },
        { "type": "choice", "text": "___ you wait for me?", "options": ["Will", "Do will", "Are will", "Does"], "answer": 0, "note": "Kip fiil soruda başa geçer." },
        { "type": "gap", "text": "They ___ the results on Friday.", "options": ["will announce", "will announces", "announce will"], "answer": 0, "note": "will + yalın fiil." }
      ]
    },
    {
      "id": "a2-04-be-going-to",
      "level": "A2",
      "order": 4,
      "title": "be going to — plan",
      "topic": "Future: be going to",
      "canDo": "Önceden yaptığım planları anlatabilirim.",
      "covers": ["MD.be_going_to.AFF"],
      "concept": {
        "summary": "Önceden verilmiş karar ve plan için kullanılır; will ise o anda verilen karar içindir. Ayrıca gözle görülür bir belirti varsa gelecek be going to ile kurulur: kara bulutlar varsa yağmur yağacaktır.",
        "formula": { "left": "am / is / are going to", "right": "+ yalın fiil" },
        "table": [
          { "form": "plan", "be": "be going to", "example": "We are going to move house." },
          { "form": "belirti", "be": "be going to", "example": "Look! It is going to rain." },
          { "form": "olumsuz", "be": "am / is / are not", "example": "I am not going to wait." },
          { "form": "karşılaştır", "be": "will = o anki karar", "example": "The phone is ringing. I'll get it." }
        ]
      },
      "examples": [
        { "en": "I am going to study medicine.", "tr": "Tıp okuyacağım.", "note": "Önceden verilmiş karar." },
        { "en": "They are going to sell their car.", "tr": "Arabalarını satacaklar.", "note": "Plan." },
        { "en": "Look at those clouds! It is going to rain.", "tr": "Şu bulutlara bak! Yağmur yağacak.", "note": "Gözle görülen belirti." },
        { "en": "She isn't going to come tonight.", "tr": "Bu akşam gelmeyecek.", "note": "Olumsuzda be fiili çekilir." },
        { "en": "Are you going to watch the match?", "tr": "Maçı izleyecek misin?", "note": "Soruda be başa geçer." }
      ],
      "mistakes": [
        { "wrong": "I going to study medicine.", "right": "I am going to study medicine.", "why": "be parçası düşmez." },
        { "wrong": "We are going to moving house.", "right": "We are going to move house.", "why": "to'dan sonra fiil yalın kalır." },
        { "wrong": "It will rain, look at the clouds.", "right": "It is going to rain, look at the clouds.", "why": "Ortada belirti varsa be going to yeğlenir." }
      ],
      "exercises": [
        { "type": "choice", "text": "We ___ visit my aunt on Sunday.", "options": ["are going to", "going to", "are go to", "will to"], "answer": 0, "note": "be + going to." },
        { "type": "choice", "text": "He is going to ___ a new job.", "options": ["look for", "looking for", "looks for", "looked for"], "answer": 0, "note": "to'dan sonra yalın fiil." },
        { "type": "choice", "text": "___ you going to tell her?", "options": ["Are", "Do", "Will", "Is"], "answer": 0, "note": "you → Are." },
        { "type": "choice", "text": "She ___ going to take the exam.", "options": ["isn't", "doesn't", "won't", "not is"], "answer": 0, "note": "Olumsuzda be çekilir." },
        { "type": "gap", "text": "I ___ going to be late again.", "options": ["am not", "not am", "don't"], "answer": 0, "note": "I am not going to." }
      ]
    },
    {
      "id": "a2-05-have-to-should",
      "level": "A2",
      "order": 5,
      "title": "have to, should, need to",
      "topic": "Modals of obligation and advice",
      "canDo": "Bir şeyin zorunlu mu yoksa tavsiye mi olduğunu ayırt ederek söyleyebilirim.",
      "covers": ["MD.have_to.AFF", "MD.should.AFF", "MD.need.AFF"],
      "concept": {
        "summary": "have to dışarıdan gelen zorunluluğu (kural, yasa), should tavsiyeyi anlatır. have to gerçek bir fiildir, o yüzden çekilir ve sorusunu do ile kurar; should ise kip fiildir, değişmez.",
        "formula": { "left": "have to / has to + yalın fiil", "right": "should + yalın fiil" },
        "table": [
          { "form": "zorunluluk", "be": "have to / has to", "example": "I have to work on Saturday." },
          { "form": "tavsiye", "be": "should", "example": "You should see a doctor." },
          { "form": "gereksizlik", "be": "don't have to", "example": "You don't have to pay." },
          { "form": "gereklilik", "be": "need to", "example": "We need to leave now." }
        ]
      },
      "examples": [
        { "en": "She has to wear a uniform.", "tr": "Üniforma giymek zorunda.", "note": "she → has to." },
        { "en": "You should rest today.", "tr": "Bugün dinlenmelisin.", "note": "Tavsiye." },
        { "en": "We don't have to hurry.", "tr": "Acele etmemize gerek yok.", "note": "Zorunlu değil; yasak değil." },
        { "en": "Do I have to book a table?", "tr": "Masa ayırtmam gerekir mi?", "note": "have to sorusu do ile kurulur." },
        { "en": "You shouldn't eat so late.", "tr": "Bu kadar geç yememelisin.", "note": "should not → shouldn't." }
      ],
      "mistakes": [
        { "wrong": "She have to wear a uniform.", "right": "She has to wear a uniform.", "why": "have gerçek fiildir, üçüncü tekilde has olur." },
        { "wrong": "You should to rest.", "right": "You should rest.", "why": "Kip fiilden sonra to gelmez." },
        { "wrong": "Have I to book a table?", "right": "Do I have to book a table?", "why": "Günlük İngilizcede have to sorusu do ile kurulur." }
      ],
      "exercises": [
        { "type": "choice", "text": "He ___ get up early every day.", "options": ["has to", "have to", "has", "is have to"], "answer": 0, "note": "he → has to." },
        { "type": "choice", "text": "You ___ drink more water.", "options": ["should", "should to", "shoulds", "are should"], "answer": 0, "note": "Tavsiye → should + yalın fiil." },
        { "type": "choice", "text": "We ___ pay; it is free.", "options": ["don't have to", "haven't to", "shouldn't to", "not have to"], "answer": 0, "note": "Gerek yok → don't have to." },
        { "type": "choice", "text": "___ she have to work tonight?", "options": ["Does", "Has", "Is", "Do"], "answer": 0, "note": "she → Does ... have to." },
        { "type": "gap", "text": "I ___ finish this before noon.", "options": ["need to", "need", "needs to be"], "answer": 0, "note": "need to + yalın fiil." }
      ]
    },
    {
      "id": "a2-06-would-can-you",
      "level": "A2",
      "order": 6,
      "title": "would like, Can you …?",
      "topic": "would and functional requests",
      "canDo": "Kibarca istekte bulunabilir, sipariş verebilir, yardım isteyebilirim.",
      "covers": ["MD.would.AFF", "INTF.can_you"],
      "concept": {
        "summary": "would want'ın kibar biçimidir: would like. Rica ederken Can you …? günlük, Could you …? ve Would you …? daha kibardır. Kip fiil oldukları için hepsinden sonra yalın fiil gelir.",
        "formula": { "left": "would like + to + fiil / isim", "right": "Can / Could / Would you + yalın fiil?" },
        "table": [
          { "form": "istek", "be": "would like", "example": "I would like a coffee." },
          { "form": "kısaltma", "be": "'d like", "example": "I'd like to book a room." },
          { "form": "rica", "be": "Can you …?", "example": "Can you help me?" },
          { "form": "daha kibar", "be": "Could / Would you …?", "example": "Could you repeat that?" }
        ]
      },
      "examples": [
        { "en": "I would like a table for two.", "tr": "İki kişilik bir masa istiyorum.", "note": "Restoranda kibar istek." },
        { "en": "Would you like some dessert?", "tr": "Tatlı ister misiniz?", "note": "İkram sorusu." },
        { "en": "Can you pass me the salt?", "tr": "Tuzu uzatır mısın?", "note": "Günlük rica." },
        { "en": "Could you speak more slowly, please?", "tr": "Biraz daha yavaş konuşur musunuz?", "note": "Could daha kibardır." },
        { "en": "I'd like to change my ticket.", "tr": "Biletimi değiştirmek istiyorum.", "note": "would → 'd." }
      ],
      "mistakes": [
        { "wrong": "I would like a coffee, please?", "right": "I would like a coffee, please.", "why": "Bu bir istek cümlesi, soru değil." },
        { "wrong": "Can you to help me?", "right": "Can you help me?", "why": "Kip fiilden sonra to gelmez." },
        { "wrong": "I would like go home.", "right": "I would like to go home.", "why": "would like fiil alacaksa to ister." }
      ],
      "exercises": [
        { "type": "choice", "text": "I ___ like to see the menu.", "options": ["would", "will", "am", "do"], "answer": 0, "note": "Kibar istek → would like." },
        { "type": "choice", "text": "___ you close the door, please?", "options": ["Could", "Do", "Are", "Should to"], "answer": 0, "note": "Kibar rica → Could you." },
        { "type": "choice", "text": "Would you like ___ with us?", "options": ["to come", "come", "coming", "came"], "answer": 0, "note": "would like + to + fiil." },
        { "type": "choice", "text": "___ you help me carry this?", "options": ["Can", "Do can", "Are", "Does"], "answer": 0, "note": "Rica → Can you." },
        { "type": "gap", "text": "We ___ like two tickets, please.", "options": ["would", "will", "are"], "answer": 0, "note": "would like kalıbı." }
      ]
    }
  ]
}
