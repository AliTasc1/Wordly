  "lessons": [
    {
      "id": "a2-08-present-perfect",
      "level": "A2",
      "order": 8,
      "title": "Present perfect — have done",
      "topic": "Present perfect (affirmative)",
      "canDo": "Hayatımda neler yaptığımı, ne zaman olduğunu söylemeden anlatabilirim.",
      "covers": [
        "TA.PRPF.AFF"
      ],
      "concept": {
        "summary": "Geçmişte olmuş ama ne zaman olduğu önemli olmayan işler için kullanılır: deneyim, yeni haber, hâlâ süren durum. Zaman söylenirse (yesterday, in 2019) artık present perfect değil past simple gerekir.",
        "formula": {
          "left": "have / has",
          "right": "+ fiilin üçüncü hâli"
        },
        "table": [
          {
            "form": "I / you / we / they",
            "be": "have + V3",
            "example": "I have finished."
          },
          {
            "form": "he / she / it",
            "be": "has + V3",
            "example": "She has finished."
          },
          {
            "form": "deneyim",
            "be": "ever / never",
            "example": "Have you ever been to Rome?"
          },
          {
            "form": "süregelen",
            "be": "for / since",
            "example": "We have lived here for ten years."
          }
        ]
      },
      "examples": [
        {
          "en": "I have lost my keys.",
          "tr": "Anahtarlarımı kaybettim.",
          "note": "Sonucu şu anda geçerli: hâlâ bulunamadı."
        },
        {
          "en": "She has visited Japan twice.",
          "tr": "Japonya'yı iki kez ziyaret etti.",
          "note": "Deneyim; ne zaman olduğu önemsiz."
        },
        {
          "en": "They have just arrived.",
          "tr": "Az önce vardılar.",
          "note": "just yeni biten iş için."
        },
        {
          "en": "We have known each other since 2015.",
          "tr": "2015'ten beri tanışıyoruz.",
          "note": "since + başlangıç noktası."
        },
        {
          "en": "He has worked here for five years.",
          "tr": "Beş yıldır burada çalışıyor.",
          "note": "for + süre."
        }
      ],
      "mistakes": [
        {
          "wrong": "I have lost my keys yesterday.",
          "right": "I lost my keys yesterday.",
          "why": "Belirli geçmiş zaman söylenince past simple gerekir."
        },
        {
          "wrong": "She has went to Japan.",
          "right": "She has gone to Japan.",
          "why": "Üçüncü hâl gerekir, ikinci hâl değil."
        },
        {
          "wrong": "We have known each other for 2015.",
          "right": "We have known each other since 2015.",
          "why": "Başlangıç noktasında since, sürede for kullanılır."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "I ___ my homework.",
          "options": [
            "have finished",
            "have finish",
            "has finished",
            "am finished"
          ],
          "answer": 0,
          "note": "I → have + V3."
        },
        {
          "type": "choice",
          "text": "She ___ to London three times.",
          "options": [
            "has been",
            "have been",
            "has went",
            "is been"
          ],
          "answer": 0,
          "note": "she → has; go'nun V3'ü been/gone."
        },
        {
          "type": "choice",
          "text": "We have lived here ___ 2018.",
          "options": [
            "since",
            "for",
            "from",
            "during"
          ],
          "answer": 0,
          "note": "Başlangıç noktası → since."
        },
        {
          "type": "choice",
          "text": "They have waited ___ two hours.",
          "options": [
            "for",
            "since",
            "from",
            "during"
          ],
          "answer": 0,
          "note": "Süre → for."
        },
        {
