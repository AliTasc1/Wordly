    {
      "id": "a2-10-relative-who-that",
      "level": "A2",
      "order": 10,
      "title": "who ve that — kim, hangi",
      "topic": "Relative pronouns: who, that, which",
      "canDo": "Bir kişiyi ya da şeyi ayrıntısıyla tarif edebilirim.",
      "covers": [
        "PREL.who",
        "PREL.that"
      ],
      "concept": {
        "summary": "İki cümleyi tek cümlede birleştirmenin yolu. İnsanlar için who, şeyler için which, ikisi için de that kullanılabilir. İlgi zamiri kendi cümleciğinde özne yerine geçtiği için ayrıca bir özne konmaz.",
        "formula": {
          "left": "kişi + who / that",
          "right": "şey + which / that"
        },
        "table": [
          {
            "form": "kişi",
            "be": "who",
            "example": "the man who lives here"
          },
          {
            "form": "şey",
            "be": "which",
            "example": "the book which won the prize"
          },
          {
            "form": "ikisi de",
            "be": "that",
            "example": "the film that scared me"
          },
          {
            "form": "dikkat",
            "be": "ikinci özne konmaz",
            "example": "the man who lives (he lives değil)"
          }
        ]
      },
      "examples": [
        {
          "en": "I know a woman who speaks five languages.",
          "tr": "Beş dil konuşan bir kadın tanıyorum.",
          "note": "Kişi → who."
        },
        {
          "en": "This is the bus that goes to the airport.",
          "tr": "Havaalanına giden otobüs bu.",
          "note": "Şey → that."
        },
        {
          "en": "The house which burned down was very old.",
          "tr": "Yanan ev çok eskiydi.",
          "note": "Şey → which."
        },
        {
          "en": "She is the teacher who helped me.",
          "tr": "Bana yardım eden öğretmen o.",
          "note": "who cümleciğin öznesi."
        },
        {
          "en": "I like films that make me think.",
          "tr": "Beni düşündüren filmleri severim.",
          "note": "Çoğul da olsa that değişmez."
        }
      ],
      "mistakes": [
        {
          "wrong": "I know a woman who she speaks five languages.",
          "right": "I know a woman who speaks five languages.",
          "why": "who zaten öznedir, ikinci özne konmaz."
        },
        {
          "wrong": "The man which lives here is a doctor.",
          "right": "The man who lives here is a doctor.",
          "why": "İnsanlar için which kullanılmaz."
        },
        {
          "wrong": "This is the bus who goes to the airport.",
          "right": "This is the bus that goes to the airport.",
          "why": "Cansız varlık için who kullanılmaz."
        }
      ],
      "exercises": [
