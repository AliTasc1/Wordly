    {
      "id": "a2-09-passive",
      "level": "A2",
      "order": 9,
      "title": "Edilgen çatı — is made, was built",
      "topic": "Passive: present and past",
      "canDo": "İşi kimin yaptığı önemli değilken olayın kendisini anlatabilirim.",
      "covers": [
        "PASS.PRESENT",
        "PASS.PAST.AFF",
        "VN.VN_N"
      ],
      "concept": {
        "summary": "Eylemi yapan belli değilse ya da önemli değilse nesne öne alınır. Yapı iki parçalıdır: be fiili zamanı taşır, asıl fiil üçüncü hâlde kalır. Yapan kişi söylenecekse by ile eklenir. Üçüncü hâl ayrıca sıfat gibi de kullanılır: a broken window.",
        "formula": {
          "left": "am / is / are / was / were",
          "right": "+ fiilin üçüncü hâli"
        },
        "table": [
          {
            "form": "geniş zaman",
            "be": "is / are + V3",
            "example": "Coffee is grown in Brazil."
          },
          {
            "form": "geçmiş",
            "be": "was / were + V3",
            "example": "The bridge was built in 1973."
          },
          {
            "form": "yapan",
            "be": "by + kişi",
            "example": "It was written by a student."
          },
          {
            "form": "sıfat gibi",
            "be": "V3 + isim",
            "example": "a broken window"
          }
        ]
      },
      "examples": [
        {
          "en": "English is spoken in many countries.",
          "tr": "İngilizce birçok ülkede konuşulur.",
          "note": "Kimin konuştuğu önemsiz."
        },
        {
          "en": "The letter was sent yesterday.",
          "tr": "Mektup dün gönderildi.",
          "note": "Geçmiş edilgen."
        },
        {
          "en": "These shoes are made in Turkey.",
          "tr": "Bu ayakkabılar Türkiye'de üretiliyor.",
          "note": "Etiketlerde sık görülen kalıp."
        },
        {
          "en": "The house was designed by my uncle.",
          "tr": "Evi amcam tasarladı.",
          "note": "Yapan by ile eklendi."
        },
        {
          "en": "We couldn't use the broken lift.",
          "tr": "Bozuk asansörü kullanamadık.",
          "note": "Üçüncü hâl ismi niteliyor."
        }
      ],
      "mistakes": [
        {
          "wrong": "The bridge was build in 1973.",
          "right": "The bridge was built in 1973.",
          "why": "Edilgende üçüncü hâl gerekir."
        },
        {
          "wrong": "English speaks in many countries.",
          "right": "English is spoken in many countries.",
          "why": "Özne işi yapmıyorsa etken çatı kullanılamaz."
        },
        {
          "wrong": "The letter sent yesterday.",
          "right": "The letter was sent yesterday.",
          "why": "be parçası düşmez."
        }
      ],
      "exercises": [
