    {
      "id": "a2-11-comparatives-more",
      "level": "A2",
      "order": 11,
      "title": "more ve the most",
      "topic": "Comparatives and superlatives with more / most",
      "canDo": "Uzun sıfatlarla karşılaştırma yapabilirim.",
      "covers": [
        "COMP.JJR.RBR.more",
        "COMP.JJS.RBS.most"
      ],
      "concept": {
        "summary": "A1'de kısa sıfatlara -er ve -est eklemiştik. İki heceden uzun sıfatlarda ek kullanılmaz, önüne more ya da the most gelir. İkisi bir arada kullanılmaz.",
        "formula": {
          "left": "more + uzun sıfat + than",
          "right": "the most + uzun sıfat"
        },
        "table": [
          {
            "form": "tek heceli",
            "be": "-er / -est",
            "example": "cheap → cheaper"
          },
          {
            "form": "iki+ heceli",
            "be": "more / most",
            "example": "expensive → more expensive"
          },
          {
            "form": "zarflar",
            "be": "more / most",
            "example": "carefully → more carefully"
          },
          {
            "form": "düzensiz",
            "be": "good / bad",
            "example": "good → better → the best"
          }
        ]
      },
      "examples": [
        {
          "en": "This hotel is more expensive than the other one.",
          "tr": "Bu otel diğerinden daha pahalı.",
          "note": "expensive uzun sıfat → more."
        },
        {
          "en": "She is the most talented singer here.",
          "tr": "Buradaki en yetenekli şarkıcı o.",
          "note": "the most + sıfat."
        },
        {
          "en": "Please drive more carefully.",
          "tr": "Lütfen daha dikkatli sür.",
          "note": "Zarflarda da more."
        },
        {
          "en": "It was the most difficult exam of the year.",
          "tr": "Yılın en zor sınavıydı.",
          "note": "En üstünlük the ister."
        },
        {
          "en": "Trains are more comfortable than buses.",
          "tr": "Trenler otobüslerden daha rahattır.",
          "note": "than karşılaştırmayı tamamlar."
        }
      ],
      "mistakes": [
        {
          "wrong": "This hotel is more cheaper.",
          "right": "This hotel is cheaper.",
          "why": "Ek ile more birlikte kullanılmaz."
        },
        {
          "wrong": "She is most talented singer.",
          "right": "She is the most talented singer.",
          "why": "En üstünlük derecesi the ister."
        },
        {
          "wrong": "It is more good than the old one.",
          "right": "It is better than the old one.",
          "why": "good düzensizdir: better."
        }
      ],
      "exercises": [
