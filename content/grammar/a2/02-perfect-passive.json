            "are made",
            "are make",
            "make",
            "is made"
          ],
          "answer": 0,
          "note": "Çoğul özne → are + V3."
        },
        {
          "type": "choice",
          "text": "The museum ___ in 1890.",
          "options": [
            "was opened",
            "was open",
            "opened was",
            "is opened"
          ],
          "answer": 0,
          "note": "Geçmiş edilgen → was + V3."
        },
        {
          "type": "choice",
          "text": "The photos ___ by a professional.",
          "options": [
            "were taken",
            "were took",
            "took",
            "are take"
          ],
          "answer": 0,
          "note": "take → taken."
        },
        {
          "type": "gap",
          "text": "Be careful with that ___ glass.",
          "options": [
            "broken",
