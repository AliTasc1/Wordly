    {
      "id": "a2-14-if-as",
      "level": "A2",
      "order": 14,
      "title": "if ve as",
      "topic": "Adverbial clauses: if, as",
      "canDo": "Koşul kurabilir, sebep ve zaman bildirebilirim.",
      "covers": [
        "CL.if",
        "CL.as"
      ],
      "concept": {
        "summary": "if koşul kurar: gerçekleşmesi mümkün bir durumda if'li cümlecik geniş zamanda, ana cümle will ile gelir. as ise \"-dığı için\" ve \"-ken\" anlamlarını taşır; hangisi olduğu cümleden anlaşılır.",
        "formula": {
          "left": "If + geniş zaman",
          "right": ", will + yalın fiil"
        },
        "table": [
          {
            "form": "koşul",
            "be": "If ... , will ...",
            "example": "If it rains, we will stay home."
          },
          {
            "form": "sıra",
            "be": "ana cümle önce",
            "example": "We will stay home if it rains."
          },
