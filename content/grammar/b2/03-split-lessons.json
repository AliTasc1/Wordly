          "text": "The manager ___ I spoke to was helpful.",
          "options": [
            "whom",
            "which",
            "what",
            "whose"
          ],
          "answer": 0,
          "note": "Kişi, nesne konumunda."
        },
        {
          "type": "choice",
          "text": "The meeting ___ was cancelled has been rescheduled.",
          "options": [
            "which",
            "who",
            "whom",
            "what"
          ],
          "answer": 0,
          "note": "Cansız → which."
        },
        {
          "type": "choice",
          "text": "The book ___ I borrowed is overdue.",
          "options": [
            "that",
            "who",
            "whom",
            "what"
          ],
          "answer": 0,
          "note": "Cansız nesne → that (düşürülebilir de)."
        },
        {
