    {
      "id": "b2-03-passive-extended",
      "level": "B2",
      "order": 3,
      "title": "Edilgen — her zamanda",
      "topic": "Passive across tenses",
      "canDo": "Resmî yazıda ve haber dilinde edilgen yapıyı her zamanda kurabilirim.",
      "covers": [
        "PASS.PRESENT.NEG",
        "PASS.PRSPF.AFF",
        "PASS.FUT.AFF"
      ],
      "concept": {
        "summary": "Edilgende zaman be fiilinde taşınır, asıl fiil hep üçüncü hâlde kalır. Hangi zamanı kuracaksan be'yi o zamana çek, sonra V3'ü ekle: is closed, was closed, has been closed, will be closed, is being closed. Olumsuzluk da be'ye takılır: aren't allowed.",
        "formula": {
          "left": "be'nin çekimi",
          "right": "+ fiilin üçüncü hâli"
        },
        "table": [
          {
            "form": "present perfect",
            "be": "has / have been + V3",
            "example": "The road has been closed."
          },
          {
            "form": "gelecek",
            "be": "will be + V3",
            "example": "You will be informed."
          },
          {
            "form": "olumsuz",
            "be": "isn't / aren't + V3",
            "example": "Photos aren't allowed."
          },
          {
            "form": "şu anda süren",
            "be": "is being + V3",
            "example": "The road is being repaired."
          }
        ]
      },
      "examples": [
        {
          "en": "The results have been published online.",
          "tr": "Sonuçlar internette yayımlandı.",
          "note": "have been + V3."
        },
        {
          "en": "All applicants will be contacted next week.",
          "tr": "Tüm başvuru sahiplerine önümüzdeki hafta ulaşılacak.",
          "note": "will be + V3."
        },
        {
          "en": "Bags are not allowed in the hall.",
          "tr": "Salona çanta alınmaz.",
          "note": "Olumsuz edilgen."
        },
        {
          "en": "The old wing has been closed since March.",
          "tr": "Eski bölüm marttan beri kapalı.",
          "note": "since ile present perfect edilgen."
        },
        {
          "en": "The forms will be checked by two people.",
          "tr": "Formlar iki kişi tarafından kontrol edilecek.",
          "note": "by + eylemi yapan."
        }
      ],
      "mistakes": [
        {
          "wrong": "The results have published online.",
          "right": "The results have been published online.",
          "why": "Edilgende be parçası düşmez."
        },
        {
          "wrong": "Bags are not allow in the hall.",
          "right": "Bags are not allowed in the hall.",
          "why": "Üçüncü hâl gerekir."
        },
        {
          "wrong": "All applicants will contacted next week.",
          "right": "All applicants will be contacted next week.",
          "why": "will'den sonra be gelir."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "The bridge ___ since 2019.",
          "options": [
            "has been closed",
            "has closed",
            "is closing",
            "was close"
          ],
          "answer": 0,
          "note": "since → present perfect edilgen."
        },
        {
          "type": "choice",
          "text": "You ___ by email once we decide.",
          "options": [
            "will be notified",
            "will notify",
            "will be notify",
            "are notify"
          ],
          "answer": 0,
          "note": "will be + V3."
        },
        {
          "type": "choice",
          "text": "Cameras ___ inside the museum.",
          "options": [
            "aren't permitted",
            "aren't permit",
            "don't permitted",
            "not permitted are"
          ],
          "answer": 0,
          "note": "Olumsuz edilgen."
        },
        {
          "type": "gap",
          "text": "The letters ___ sent yesterday.",
          "options": [
            "were",
            "have",
            "are been"
          ],
          "answer": 0,
          "note": "Geçmiş edilgen → were + V3."
        },
        {
          "type": "choice",
          "text": "The road ___ repaired at the moment.",
          "options": [
            "is being",
            "is",
            "has been being",
            "was being now"
          ],
          "answer": 0,
          "note": "Şu an süren edilgen → is being + V3."
        },
        {
          "type": "choice",
          "text": "The decision ___ already been taken.",
          "options": [
            "has",
            "is",
            "was",
            "had being"
          ],
          "answer": 0,
          "note": "Present perfect edilgen → has been + V3."
        },
        {
          "type": "choice",
          "text": "When we arrived, the tables ___ been laid.",
          "options": [
            "had",
            "have",
            "were",
            "are"
          ],
          "answer": 0,
          "note": "Past perfect edilgen → had been + V3."
        },
        {
          "type": "gap",
          "text": "The building ___ being used when the fire started.",
          "options": [
            "was",
            "is",
            "has"
          ],
          "answer": 0,
          "note": "Geçmişte süren edilgen → was being + V3."
        },
        {
          "type": "choice",
          "text": "By next month the work ___ been completed.",
          "options": [
            "will have",
            "will",
            "has",
            "is"
          ],
          "answer": 0,
          "note": "Future perfect edilgen → will have been + V3."
        },
        {
          "type": "choice",
          "text": "Mobile phones ___ during the exam.",
          "options": [
            "are not allowed",
            "are not allow",
            "do not allowed",
            "not are allowed"
          ],
          "answer": 0,
          "note": "Olumsuz edilgen: be + not + V3."
        }
      ]
    },
    {
      "id": "b2-04-passive-indirect-object",
      "level": "B2",
      "order": 4,
      "title": "She was given a prize — iki nesneli fiillerin edilgeni",
      "topic": "Passive with indirect objects",
      "canDo": "give, send, offer gibi fiillerin edilgenini, kişiyi öne alarak doğal biçimde kurabilirim.",
      "covers": [
        "PASS.IO.AFF"
      ],
      "concept": {
        "summary": "give, send, offer, show, tell, teach gibi fiillerin iki nesnesi vardır: bir kişi, bir şey. Bu yüzden iki farklı edilgen kurulabilir. İngilizce genelde kişiyi özne yapanı yeğler: She was given a prize. Kişi özne konumuna geçince artık to almaz; \"She was given to a prize\" yanlıştır.",
        "formula": {
          "left": "kişi + be + V3 + şey",
          "right": "She was given a prize."
        },
        "table": [
          {
            "form": "etken",
            "be": "They gave her a prize.",
            "example": "iki nesne: her, a prize"
          },
          {
            "form": "yeğlenen edilgen",
            "be": "She was given a prize.",
            "example": "kişi özne"
          },
          {
            "form": "öteki edilgen",
            "be": "A prize was given to her.",
            "example": "şey özne, kişi to alır"
          },
          {
            "form": "yanlış",
            "be": "to düşer",
            "example": "not: She was given to a prize."
          }
        ]
      },
      "examples": [
        {
          "en": "She was offered a new position.",
          "tr": "Ona yeni bir pozisyon teklif edildi.",
          "note": "Kişi özne konumuna alındı."
        },
        {
          "en": "We were told nothing about the delay.",
          "tr": "Gecikme hakkında bize hiçbir şey söylenmedi.",
          "note": "tell'in edilgeni."
        },
        {
          "en": "Every student was sent a copy of the timetable.",
          "tr": "Her öğrenciye ders programının bir kopyası gönderildi.",
          "note": "send + kişi + şey."
        },
        {
          "en": "He was shown the new machine on his first day.",
          "tr": "İlk gün ona yeni makine gösterildi.",
          "note": "show'un edilgeni."
        },
        {
          "en": "A letter was sent to every member.",
          "tr": "Her üyeye bir mektup gönderildi.",
          "note": "Şey özne olunca kişi to alır."
        }
      ],
      "mistakes": [
        {
          "wrong": "She was offered to a new position.",
          "right": "She was offered a new position.",
          "why": "Kişi zaten özne; to gerekmez."
        },
        {
          "wrong": "Was given she a prize?",
          "right": "Was she given a prize?",
          "why": "Soruda özne be ile V3 arasında durur."
        },
        {
          "wrong": "We were told about nothing the delay.",
          "right": "We were told nothing about the delay.",
          "why": "Nesne fiilden hemen sonra gelir."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "The students ___ a certificate at the end.",
          "options": [
            "were given",
            "were gave",
            "gave were",
            "was given"
          ],
          "answer": 0,
          "note": "Kişi özne, iki nesneli fiil."
        },
        {
          "type": "choice",
          "text": "She ___ the job before the interviews finished.",
          "options": [
            "was offered",
            "was offered to",
            "offered was",
            "was offer"
          ],
          "answer": 0,
          "note": "Kişi özne → to gelmez."
        },
        {
          "type": "choice",
          "text": "We ___ nothing about the change of plan.",
          "options": [
            "were told",
            "were telling",
            "told were",
            "was told"
          ],
          "answer": 0,
          "note": "tell'in edilgeni, çoğul özne."
        },
        {
          "type": "gap",
          "text": "Each new member ___ a card and a key.",
          "options": [
            "is given",
            "is give",
            "gives"
          ],
          "answer": 0,
          "note": "Kişi özne → is given."
        },
        {
          "type": "choice",
          "text": "He ___ the plans on his first morning.",
          "options": [
            "was shown",
            "was show",
            "showed was",
            "was showing"
          ],
          "answer": 0,
          "note": "show'un edilgeni."
        },
        {
          "type": "choice",
          "text": "A copy ___ to every household last week.",
          "options": [
            "was sent",
            "was sent to be",
            "sent was",
            "were sent"
          ],
          "answer": 0,
          "note": "Şey özne → kişi to alır."
        },
        {
          "type": "choice",
          "text": "The children ___ how to use the machine safely.",
          "options": [
            "were taught",
