    {
      "id": "b2-10-relative-with-preposition",
      "level": "B2",
      "order": 10,
      "title": "the room in which — edat ve ilgi zamiri",
      "topic": "Preposition + relative pronoun",
      "canDo": "Resmî yazıda edatı ilgi zamirinin önüne alarak cümle kurabilirim.",
      "covers": [
        "PREL.PREP_PREL"
      ],
      "concept": {
        "summary": "Günlük dilde edat cümleciğin sonunda kalır: the room we met in. Resmî yazıda edat ilgi zamirinin önüne alınır: the room in which we met. Bu yapıda iki kural vardır: edattan sonra kişi için whom, cansız için which gelir; that ve who edattan sonra kullanılamaz. Aitlik için of which kalıbı vardır: the subject of which.",
        "formula": {
          "left": "edat + whom (kişi)",
          "right": "edat + which (cansız)"
        },
        "table": [
          {
            "form": "günlük",
            "be": "… we met in",
            "example": "the room we met in"
          },
          {
            "form": "resmî",
            "be": "in which",
            "example": "the room in which we met"
          },
          {
            "form": "kişi",
            "be": "to whom",
            "example": "the person to whom I spoke"
          },
          {
            "form": "aitlik",
            "be": "of which",
            "example": "a talk, the subject of which …"
          }
        ]
      },
      "examples": [
        {
          "en": "This is the house in which he was born.",
          "tr": "Burası doğduğu ev.",
          "note": "Edat + which, resmî."
        },
        {
          "en": "The candidate to whom we offered the job declined.",
          "tr": "İşi teklif ettiğimiz aday reddetti.",
          "note": "Edattan sonra zorunlu olarak whom."
        },
        {
          "en": "That is the fund from which the money came.",
          "tr": "Para o fondan geldi.",
          "note": "from + which."
        },
        {
          "en": "He gave a talk, the subject of which was climate.",
          "tr": "Konusu iklim olan bir konuşma yaptı.",
          "note": "of which — aitlik."
        },
        {
          "en": "The company for which she works has moved.",
          "tr": "Çalıştığı şirket taşındı.",
          "note": "for + which."
        }
      ],
      "mistakes": [
        {
          "wrong": "The candidate to who we offered the job declined.",
          "right": "The candidate to whom we offered the job declined.",
          "why": "Edattan hemen sonra whom gelir, who değil."
        },
        {
          "wrong": "This is the house in that he was born.",
          "right": "This is the house in which he was born.",
          "why": "that edattan sonra kullanılamaz."
        },
        {
          "wrong": "The fund from which the money came from was closed.",
          "right": "The fund from which the money came was closed.",
          "why": "Edat bir kez kullanılır, sonda tekrar edilmez."
        }
      ],
