    {
      "id": "b2-09-relative-object",
      "level": "B2",
      "order": 9,
      "title": "whom, which, that — nesne konumundaki ilgi zamiri",
      "topic": "Relative pronouns in object position",
      "canDo": "İlgi zamirinin cümlecikte nesne olduğu durumlarda doğru biçimi seçebilirim.",
      "covers": [
        "PRELO.who",
        "PRELO.whom",
        "PRELO.which",
        "PRELO.that",
        "PREL.which"
      ],
      "concept": {
        "summary": "İlgi zamiri kendi cümleciğinde özne değil nesne olabilir: the man whom I met. Bu durumda günlük dilde who kullanılır ya da zamir düşürülür; whom resmî dilde tercih edilir. Cansız varlıklarda which ya da that gelir. İlgi zamiri zaten nesnedir; cümleciğe ikinci bir nesne konmaz.",
        "formula": {
          "left": "nesne konumunda: who / whom / that / ∅",
          "right": "cansızda which / that"
        },
        "table": [
          {
            "form": "günlük",
            "be": "who / that / ∅",
            "example": "the man (who) I met"
          },
          {
            "form": "resmî",
            "be": "whom",
            "example": "the man whom I met"
          },
          {
            "form": "cansız",
            "be": "which / that / ∅",
            "example": "the report (which) I read"
          },
          {
            "form": "virgüllü",
            "be": "which (that olmaz)",
            "example": "the report, which was late,"
          }
        ]
      },
      "examples": [
        {
          "en": "The colleague whom I mentioned has resigned.",
          "tr": "Sözünü ettiğim meslektaş istifa etti.",
          "note": "Resmî; nesne konumunda whom."
        },
        {
          "en": "The report which you sent was very useful.",
          "tr": "Gönderdiğin rapor çok işime yaradı.",
          "note": "Cansız nesne → which."
        },
        {
          "en": "She is the person I trust most.",
          "tr": "En çok güvendiğim kişi o.",
          "note": "Zamir düşürüldü."
        },
        {
          "en": "The film that we watched last night was too long.",
          "tr": "Dün gece izlediğimiz film çok uzundu.",
          "note": "Cansız nesne → that."
        },
        {
          "en": "The report, which was written in a hurry, has several mistakes.",
          "tr": "Aceleyle yazılan rapor birkaç hata içeriyor.",
          "note": "Virgüllü ek bilgide that kullanılmaz."
        }
      ],
      "mistakes": [
        {
          "wrong": "The report which you sent it was useful.",
          "right": "The report which you sent was useful.",
          "why": "İlgi zamiri zaten nesnedir, ikinci nesne konmaz."
        },
        {
          "wrong": "The report, that was written in a hurry, has mistakes.",
          "right": "The report, which was written in a hurry, has mistakes.",
          "why": "Virgüllü ek bilgide that kullanılmaz."
        },
        {
          "wrong": "The man which I met was her brother.",
          "right": "The man whom I met was her brother.",
          "why": "Kişi için which kullanılmaz."
        }
      ],
      "exercises": [
