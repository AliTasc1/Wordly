  "lessons": [
    {
      "id": "b2-08-enough-such-so",
      "level": "B2",
      "order": 8,
      "title": "enough, so, such",
      "topic": "Degree modifiers: enough, so, such",
      "canDo": "Derece ve sonuç bildirerek daha etkili cümleler kurabilirim.",
      "covers": [
        "RBDEG.enough",
        "RBDEG.such_JJ"
      ],
      "concept": {
        "summary": "enough sıfat ve zarftan sonra, isimden önce gelir — Türkçedeki \"yeterince\" her iki yerde de aynı durduğu için sık karışır. so sıfat ya da zarfı, such ise isim öbeğini güçlendirir; sonuç bildirirken that'li cümlecik alırlar.",
        "formula": {
          "left": "sıfat + enough / enough + isim",
          "right": "so + sıfat / such a + sıfat + isim"
        },
        "table": [
          {
            "form": "sıfattan sonra",
            "be": "old enough",
            "example": "He isn't old enough to drive."
          },
          {
            "form": "isimden önce",
            "be": "enough time",
            "example": "We don't have enough time."
          },
          {
            "form": "so",
            "be": "+ sıfat / zarf",
            "example": "It was so cold that we left."
          },
          {
            "form": "such",
            "be": "+ (a) sıfat + isim",
            "example": "It was such a cold day."
          }
        ]
      },
      "examples": [
        {
          "en": "The soup isn't hot enough.",
          "tr": "Çorba yeterince sıcak değil.",
          "note": "Sıfattan sonra."
        },
        {
          "en": "There isn't enough space for everyone.",
          "tr": "Herkese yetecek yer yok.",
          "note": "İsimden önce."
        },
        {
          "en": "He drove so fast that I felt sick.",
          "tr": "O kadar hızlı sürdü ki midem bulandı.",
          "note": "so + zarf + that."
        },
        {
          "en": "It was such a long meeting that everyone got tired.",
          "tr": "Öyle uzun bir toplantıydı ki herkes yoruldu.",
          "note": "such a + sıfat + isim."
        },
        {
          "en": "She was old enough to decide for herself.",
          "tr": "Kendi kararını verecek yaştaydı.",
          "note": "enough + to + fiil."
        }
      ],
      "mistakes": [
        {
          "wrong": "The soup isn't enough hot.",
          "right": "The soup isn't hot enough.",
          "why": "enough sıfattan sonra gelir."
        },
        {
          "wrong": "It was so a long meeting.",
          "right": "It was such a long meeting.",
          "why": "İsim varsa such kullanılır."
        },
        {
          "wrong": "It was such cold that we left.",
          "right": "It was so cold that we left.",
          "why": "İsim yoksa so kullanılır."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "This box isn't ___ to carry alone.",
          "options": [
            "light enough",
            "enough light",
            "so light",
            "such light"
          ],
          "answer": 0,
          "note": "Sıfat + enough."
        },
        {
          "type": "choice",
          "text": "We don't have ___ for a taxi.",
          "options": [
            "enough money",
            "money enough of",
            "so money",
            "such money"
          ],
          "answer": 0,
          "note": "enough + isim."
        },
        {
          "type": "choice",
          "text": "It was ___ noisy that nobody could sleep.",
          "options": [
            "so",
            "such",
            "such a",
            "enough"
          ],
          "answer": 0,
          "note": "Sıfat tek başına → so."
        },
        {
          "type": "choice",
          "text": "She is ___ kind person.",
          "options": [
            "such a",
            "so a",
            "so",
            "enough"
          ],
          "answer": 0,
          "note": "Tekil isim öbeği → such a."
        },
        {
          "type": "gap",
          "text": "He spoke ___ quietly that we couldn't hear him.",
          "options": [
            "so",
            "such",
            "such a"
          ],
          "answer": 0,
          "note": "Zarf → so."
        },
        {
          "type": "choice",
          "text": "It was ___ a long journey that we slept most of the way.",
          "options": [
            "such",
            "so",
            "too",
            "very"
          ],
          "answer": 0,
          "note": "such + a + sıfat + isim."
        },
        {
          "type": "choice",
          "text": "The box was ___ heavy that nobody could lift it.",
          "options": [
            "so",
            "such",
            "too",
            "enough"
          ],
          "answer": 0,
          "note": "so + sıfat + that."
        },
        {
          "type": "choice",
          "text": "He is not old ___ to drive.",
          "options": [
            "enough",
            "so",
            "such",
            "too"
          ],
          "answer": 0,
          "note": "Sıfattan sonra → enough."
        },
        {
          "type": "gap",
          "text": "There were ___ many people that we could not get in.",
          "options": [
            "so",
            "such",
            "too much"
          ],
          "answer": 0,
          "note": "so many + isim + that."
        },
        {
          "type": "choice",
          "text": "We have ___ time to finish this properly.",
          "options": [
            "enough",
            "so",
            "such",
            "too"
          ],
          "answer": 0,
          "note": "İsimden önce → enough time."
        }
      ]
    },
    {
      "id": "b2-11-whether-so-that",
      "level": "B2",
      "order": 11,
      "title": "whether, so that, in order to",
      "topic": "Whether-clauses and purpose clauses",
      "canDo": "Seçenekleri ve amacı açık biçimde ifade edebilirim.",
      "covers": [
        "CL.WH.whether",
        "CL.so_that",
        "TO.in_order_to_do"
      ],
      "concept": {
        "summary": "whether if ile aynı işi görür ama iki seçenek varken ve edattan sonra yalnızca whether kullanılabilir. Amaç bildirirken in order to yalın fiil alır; özne değişiyorsa so that + kip fiil gerekir.",
        "formula": {
          "left": "whether … or not",
          "right": "so that + özne + can / would"
        },
        "table": [
          {
            "form": "whether",
            "be": "iki seçenek",
            "example": "whether to stay or go"
          },
          {
            "form": "edattan sonra",
            "be": "yalnız whether",
            "example": "It depends on whether he agrees."
          },
          {
            "form": "amaç, aynı özne",
            "be": "in order to / to",
            "example": "I left early in order to catch the train."
          },
          {
            "form": "amaç, farklı özne",
            "be": "so that",
            "example": "I left early so that she could rest."
          }
        ]
      },
      "examples": [
        {
          "en": "I can't decide whether to accept the offer.",
          "tr": "Teklifi kabul edip etmemeye karar veremiyorum.",
          "note": "whether + to."
        },
        {
          "en": "It depends on whether the flight is on time.",
          "tr": "Uçuşun zamanında olup olmamasına bağlı.",
          "note": "Edattan sonra if kullanılamaz."
        },
        {
          "en": "She wrote it down in order to remember it.",
          "tr": "Hatırlamak için yazdı.",
          "note": "Aynı özne → in order to."
        },
        {
          "en": "I turned the light off so that he could sleep.",
          "tr": "Uyuyabilsin diye ışığı kapattım.",
          "note": "Farklı özne → so that."
        },
        {
          "en": "Let me know whether or not you are coming.",
          "tr": "Gelip gelmeyeceğini bana bildir.",
          "note": "whether or not kalıbı."
        }
      ],
      "mistakes": [
        {
          "wrong": "It depends on if he agrees.",
          "right": "It depends on whether he agrees.",
          "why": "Edattan sonra if kullanılmaz."
        },
        {
          "wrong": "I left early so that to catch the train.",
          "right": "I left early in order to catch the train.",
          "why": "so that'ten sonra özneli cümlecik gelir."
        },
        {
          "wrong": "I turned the light off for he could sleep.",
          "right": "I turned the light off so that he could sleep.",
          "why": "Amaç cümleciği so that ile kurulur."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "I'm not sure ___ to call him now.",
          "options": [
            "whether",
            "if",
            "that",
            "so"
          ],
          "answer": 0,
          "note": "to'dan önce whether."
        },
        {
          "type": "choice",
          "text": "Everything depends on ___ they agree.",
          "options": [
            "whether",
            "if",
            "that",
            "which"
          ],
          "answer": 0,
          "note": "Edattan sonra whether."
        },
        {
          "type": "choice",
          "text": "He spoke slowly ___ everyone could follow.",
          "options": [
            "so that",
            "in order to",
            "for to",
            "so as"
          ],
          "answer": 0,
          "note": "Farklı özne → so that."
        },
        {
          "type": "choice",
          "text": "She studied hard ___ pass the exam.",
          "options": [
            "in order to",
            "so that",
            "for to",
            "in order that to"
          ],
          "answer": 0,
          "note": "Aynı özne → in order to."
        },
        {
          "type": "gap",
          "text": "Tell me ___ or not you need help.",
          "options": [
            "whether",
            "if",
            "that"
          ],
          "answer": 0,
          "note": "whether or not kalıbı."
        },
        {
          "type": "choice",
          "text": "I am not sure ___ she will accept the offer.",
          "options": [
            "whether",
            "that",
            "what",
            "if that"
          ],
          "answer": 0,
          "note": "Belirsizlik → whether."
        },
        {
          "type": "choice",
          "text": "They moved the meeting ___ the night staff could attend.",
          "options": [
            "so that",
            "so as",
            "in order",
            "for that"
          ],
          "answer": 0,
          "note": "Amaç + cümlecik → so that."
        },
        {
          "type": "choice",
          "text": "She left early ___ to avoid the traffic.",
          "options": [
            "in order",
            "so that",
            "for",
            "because"
          ],
          "answer": 0,
          "note": "in order to + fiil."
        },
        {
          "type": "gap",
          "text": "We have to decide ___ to go ahead or wait.",
          "options": [
            "whether",
            "if",
            "that"
          ],
          "answer": 0,
          "note": "whether + to + fiil (if olmaz)."
        },
        {
          "type": "choice",
          "text": "Write it down ___ you do not forget.",
          "options": [
            "so that",
            "in order to",
            "so as to",
            "for to"
          ],
          "answer": 0,
          "note": "Arkasından cümlecik geliyor → so that."
        }
      ]
    },
    {
      "id": "b2-12-whatever-none",
      "level": "B2",
      "order": 12,
      "title": "whatever, whoever, none",
      "topic": "-ever words and the pronoun none",
      "canDo": "Koşul ne olursa olsun geçerli olan şeyleri anlatabilirim.",
      "covers": [
        "WH.-ever",
        "PIND.none"
      ],
      "concept": {
        "summary": "Soru kelimesine -ever eklenince \"her ne olursa olsun\" anlamı doğar. none ise \"hiçbiri\" demektir ve of ile kullanılır; no'dan farkı isimsiz kullanılabilmesidir.",
        "formula": {
          "left": "whatever / whoever / whenever",
          "right": "none of + belirli grup"
        },
        "table": [
          {
            "form": "whatever",
            "be": "ne olursa",
            "example": "Take whatever you need."
          },
          {
            "form": "whoever",
            "be": "kim olursa",
            "example": "Whoever comes is welcome."
          },
          {
            "form": "whenever",
            "be": "ne zaman olursa",
            "example": "Call me whenever you like."
          },
          {
            "form": "none of",
            "be": "hiçbiri",
            "example": "None of them replied."
          }
        ]
      },
      "examples": [
        {
          "en": "Whatever you decide, I will support you.",
          "tr": "Ne karar verirsen ver, seni desteklerim.",
          "note": "Koşul ne olursa olsun."
        },
        {
          "en": "Whoever wrote this made a mistake.",
          "tr": "Bunu kim yazdıysa bir hata yapmış.",
          "note": "whoever cümleciğin öznesi."
        },
        {
          "en": "You can call me whenever you want.",
          "tr": "İstediğin zaman arayabilirsin.",
          "note": "Zaman."
        },
        {
          "en": "None of the shops were open.",
          "tr": "Dükkânların hiçbiri açık değildi.",
          "note": "none of + belirli grup."
        },
        {
          "en": "However hard I try, it never works.",
          "tr": "Ne kadar uğraşsam da hiç işe yaramıyor.",
          "note": "however + sıfat/zarf."
        }
      ],
      "mistakes": [
        {
          "wrong": "Whatever will you decide, I will support you.",
          "right": "Whatever you decide, I will support you.",
          "why": "-ever cümleciğinde soru düzeni kullanılmaz."
        },
        {
          "wrong": "No of them replied.",
          "right": "None of them replied.",
          "why": "of ile kullanılan biçim none'dır."
        },
        {
          "wrong": "None the shops were open.",
          "right": "None of the shops were open.",
          "why": "none belirli bir grupla of ister."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "___ you need, just ask.",
          "options": [
            "Whatever",
            "What ever does",
            "Whatever does",
            "However"
          ],
          "answer": 0,
          "note": "Nesne, düz sıra."
        },
        {
          "type": "choice",
          "text": "___ left the door open should close it.",
          "options": [
            "Whoever",
            "Whomever did",
            "Whatever",
            "However"
          ],
          "answer": 0,
          "note": "Kişi + özne konumu."
        },
        {
          "type": "choice",
          "text": "___ of my friends came to the party.",
          "options": [
            "None",
            "No",
            "Not",
            "Any"
          ],
          "answer": 0,
          "note": "of ile none."
        },
        {
          "type": "choice",
          "text": "Visit us ___ you are in town.",
          "options": [
            "whenever",
            "whatever",
            "whoever",
            "however"
          ],
          "answer": 0,
          "note": "Zaman → whenever."
        },
        {
          "type": "gap",
          "text": "___ hard it looks, keep trying.",
          "options": [
            "However",
            "Whatever",
            "Whenever"
          ],
          "answer": 0,
          "note": "however + sıfat."
        },
        {
          "type": "choice",
          "text": "___ happens, call me first.",
          "options": [
            "Whatever",
            "However",
            "Whoever",
            "Whichever one"
          ],
          "answer": 0,
          "note": "Ne olursa olsun → whatever."
        },
        {
          "type": "choice",
          "text": "___ wrote this knew the building well.",
          "options": [
            "Whoever",
            "Whatever",
            "However",
            "Wherever"
          ],
          "answer": 0,
          "note": "Her kimse → whoever."
        },
        {
          "type": "choice",
          "text": "I tried three shops but ___ of them had it.",
          "options": [
            "none",
            "no one",
            "nothing",
            "neither ones"
          ],
          "answer": 0,
          "note": "Üç şey → none of them."
        },
        {
          "type": "gap",
          "text": "___ hard she tries, the result is the same.",
          "options": [
            "However",
            "Whatever",
            "Whoever"
          ],
          "answer": 0,
          "note": "however + sıfat/zarf."
        },
        {
          "type": "choice",
          "text": "Take ___ seat you like.",
          "options": [
            "whichever",
            "whatever one",
            "whoever",
            "however"
          ],
          "answer": 0,
          "note": "Sınırlı seçenekten → whichever."
        }
      ]
    }
  ]
