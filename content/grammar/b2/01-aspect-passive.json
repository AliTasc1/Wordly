  "lessons": [
    {
      "id": "b2-01-perfect-progressive",
      "level": "B2",
      "order": 1,
      "title": "have been doing, will be doing",
      "topic": "Present perfect progressive and future progressive",
      "canDo": "Bir işin ne kadar süredir devam ettiğini ve gelecekte hangi anda süreceğini anlatabilirim.",
      "covers": [
        "TA.PRPFPRG.AFF",
        "TA.FUTPRG.AFF",
        "MD.MD_PRG.AFF"
      ],
      "concept": {
        "summary": "Present perfect sonuca bakar, present perfect progressive sürece bakar: \"üç kitap yazdım\" ile \"üç aydır yazıyorum\" farkı. Future progressive ise gelecekte belirli bir anda sürmekte olacak işi anlatır ve İngilizcede nazik soru sormanın da yoludur.",
        "formula": {
          "left": "have / has been + fiil-ing",
          "right": "will be + fiil-ing"
        },
        "table": [
          {
            "form": "süre vurgusu",
            "be": "have been + -ing",
            "example": "I have been waiting for an hour."
          },
          {
            "form": "sonuç vurgusu",
            "be": "have + V3",
            "example": "I have written three letters."
          },
          {
            "form": "gelecekte süren",
            "be": "will be + -ing",
            "example": "This time tomorrow I will be flying."
          },
          {
            "form": "kip + süren",
            "be": "must be + -ing",
            "example": "She must be working late."
          }
        ]
      },
      "examples": [
        {
          "en": "I have been studying English for six years.",
          "tr": "Altı yıldır İngilizce çalışıyorum.",
          "note": "Süre vurgulanıyor, iş sürüyor."
        },
        {
          "en": "She has been working here since March.",
          "tr": "Mart'tan beri burada çalışıyor.",
          "note": "since + başlangıç."
        },
        {
          "en": "Your eyes are red. Have you been crying?",
          "tr": "Gözlerin kızarmış. Ağlıyor muydun?",
          "note": "Görünen sonuçtan süreci sormak."
        },
        {
          "en": "This time next week we will be sitting on a beach.",
          "tr": "Gelecek hafta bu saatlerde bir sahilde oturuyor olacağız.",
          "note": "Gelecekte süren iş."
        },
        {
          "en": "He must be waiting outside.",
          "tr": "Dışarıda bekliyor olmalı.",
          "note": "Kip + be + -ing."
        }
      ],
      "mistakes": [
        {
          "wrong": "I am working here since March.",
          "right": "I have been working here since March.",
          "why": "Geçmişte başlayıp süren işte present perfect progressive gerekir."
        },
        {
          "wrong": "I have been knowing him for years.",
          "right": "I have known him for years.",
          "why": "know gibi durum fiilleri -ing almaz."
        },
        {
          "wrong": "This time tomorrow I will fly to Rome.",
          "right": "This time tomorrow I will be flying to Rome.",
          "why": "Belirli bir anda süren iş için will be + -ing."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "They ___ for the bus for twenty minutes.",
          "options": [
            "have been waiting",
            "have waited been",
            "are waiting since",
            "waited have"
          ],
          "answer": 0,
          "note": "Süre vurgusu."
        },
        {
          "type": "choice",
          "text": "How long ___ you been learning Spanish?",
          "options": [
            "have",
            "are",
            "did",
            "do"
          ],
          "answer": 0,
          "note": "have + been + -ing."
        },
        {
          "type": "choice",
          "text": "At nine tonight I ___ the exam.",
          "options": [
            "will be taking",
            "will take been",
            "am taking will",
            "will been take"
          ],
          "answer": 0,
          "note": "Gelecekte süren iş."
        },
        {
          "type": "choice",
          "text": "The lights are on; they ___ at home.",
          "options": [
            "must be",
            "must been",
            "must being",
            "are must"
          ],
          "answer": 0,
          "note": "Kip + be."
        },
        {
          "type": "gap",
          "text": "She ___ been feeling ill all week.",
          "options": [
            "has",
            "have",
            "is"
          ],
          "answer": 0,
          "note": "she → has been + -ing."
        },
        {
          "type": "choice",
          "text": "She ___ for the exam since six o'clock this morning.",
          "options": [
            "has been studying",
            "is studying",
            "studies",
            "has studied since"
          ],
          "answer": 0,
          "note": "Süregelen iş → have been + V-ing."
        },
        {
          "type": "choice",
          "text": "This time next week we ___ on a beach.",
          "options": [
            "will be lying",
            "will lie",
            "are lying",
            "will have lain"
          ],
          "answer": 0,
          "note": "Gelecekte o anda sürecek iş → will be + V-ing."
        },
        {
          "type": "choice",
          "text": "They ___ here for twenty minutes before the bus came.",
          "options": [
            "had been waiting",
            "have been waiting",
            "were waiting for",
            "are waiting"
          ],
          "answer": 0,
          "note": "Geçmişteki bir andan öncesine uzanan süre → had been + V-ing."
        },
        {
          "type": "gap",
          "text": "How long ___ you been working on this project?",
          "options": [
            "have",
            "are",
            "do"
          ],
          "answer": 0,
          "note": "How long + have been + V-ing."
        },
        {
          "type": "choice",
          "text": "My hands are dirty because I ___ in the garden.",
          "options": [
            "have been digging",
            "dug",
            "have dug",
            "am digging"
          ],
          "answer": 0,
          "note": "Şimdiki hâli açıklayan süregelen iş."
        }
      ]
