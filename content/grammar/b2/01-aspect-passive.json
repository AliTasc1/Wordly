    {
      "id": "b2-02-modal-perfect",
      "level": "B2",
      "order": 2,
      "title": "must have, might have, should have",
      "topic": "Modal + perfect infinitive",
      "canDo": "Geçmişte olanlar hakkında tahmin yürütebilir, pişmanlık ve eleştiri belirtebilirim.",
      "covers": [
        "MD.MD_PF.AFF",
        "MD.MD_PF.NEG"
      ],
      "concept": {
        "summary": "Kip fiilden sonra have + V3 gelince bakış geçmişe döner. must have güçlü tahmin, might have zayıf ihtimal, should have yapılmayan ama yapılması gereken şeyi anlatır. can't have ise \"olamaz\" der.",
        "formula": {
          "left": "kip + have",
          "right": "+ fiilin üçüncü hâli"
        },
        "table": [
          {
            "form": "must have",
            "be": "kesin tahmin",
            "example": "He must have missed the train."
          },
          {
            "form": "might / may have",
            "be": "ihtimal",
            "example": "She might have forgotten."
          },
          {
            "form": "can't have",
            "be": "imkânsız",
            "example": "They can't have finished already."
          },
          {
            "form": "should have",
            "be": "pişmanlık",
            "example": "I should have called you."
          }
        ]
      },
      "examples": [
        {
          "en": "The ground is wet; it must have rained.",
          "tr": "Yer ıslak, yağmur yağmış olmalı.",
          "note": "Kanıta dayalı çıkarım."
        },
        {
          "en": "She might have left already.",
          "tr": "Çoktan çıkmış olabilir.",
          "note": "Zayıf ihtimal."
        },
        {
          "en": "You should have told me earlier.",
          "tr": "Bana daha önce söylemeliydin.",
          "note": "Yapılmayan şey; eleştiri."
        },
        {
          "en": "He can't have seen us in that crowd.",
          "tr": "O kalabalıkta bizi görmüş olamaz.",
          "note": "İmkânsızlık."
        },
        {
          "en": "I shouldn't have eaten so much.",
          "tr": "Bu kadar çok yememeliydim.",
          "note": "Pişmanlık."
        }
      ],
      "mistakes": [
        {
          "wrong": "He must had missed the train.",
          "right": "He must have missed the train.",
          "why": "Kipten sonra have yalın kalır."
        },
        {
          "wrong": "You should have told me yesterday, but you did.",
          "right": "You should have told me yesterday, but you didn't.",
          "why": "should have yapılmayan işi anlatır."
        },
        {
          "wrong": "She might forgot the meeting.",
          "right": "She might have forgotten the meeting.",
          "why": "Geçmişe bakan tahminde have + V3 gerekir."
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "text": "The car is gone; someone ___ taken it.",
          "options": [
            "must have",
            "must had",
            "must has",
            "must to have"
          ],
          "answer": 0,
          "note": "Kesin tahmin → must have + V3."
        },
        {
          "type": "choice",
          "text": "I ___ studied harder for that exam.",
          "options": [
            "should have",
            "should had",
            "should has",
            "should of"
          ],
          "answer": 0,
          "note": "Pişmanlık → should have."
        },
        {
          "type": "choice",
          "text": "They ___ arrived yet; it's too early.",
          "options": [
            "can't have",
            "can't had",
            "mustn't have to",
            "don't can have"
          ],
          "answer": 0,
          "note": "İmkânsızlık → can't have."
        },
        {
          "type": "choice",
          "text": "She ___ have missed the message.",
          "options": [
            "may",
            "may to",
            "mays",
            "is may"
          ],
          "answer": 0,
          "note": "İhtimal → may have."
        },
        {
          "type": "gap",
          "text": "We ___ have booked earlier; now it's full.",
          "options": [
            "should",
            "shall",
            "would to"
          ],
          "answer": 0,
          "note": "should have + V3."
        },
        {
          "type": "choice",
          "text": "The lights are off. They ___ home.",
          "options": [
            "must have gone",
            "must go",
            "must have went",
            "must be gone to"
          ],
          "answer": 0,
          "note": "Geçmişe dair güçlü çıkarım → must have + V3."
        },
        {
          "type": "choice",
          "text": "You ___ told me earlier; I could have helped.",
          "options": [
            "should have",
            "should",
            "must",
            "would be"
          ],
          "answer": 0,
          "note": "Yapılmayan doğru şey → should have + V3."
        },
        {
          "type": "choice",
          "text": "She is late. She ___ missed the train.",
          "options": [
            "might have",
            "might",
            "must be",
            "should"
          ],
          "answer": 0,
          "note": "Geçmişe dair ihtimal → might have + V3."
        },
        {
          "type": "gap",
          "text": "He ___ have seen us; he was looking the other way.",
          "options": [
            "cannot",
            "must",
            "should"
          ],
          "answer": 0,
          "note": "İmkânsız çıkarım → cannot have + V3."
        },
        {
          "type": "choice",
          "text": "I ___ have left my wallet in the taxi.",
          "options": [
            "may",
            "may to",
            "may be",
            "may had"
          ],
          "answer": 0,
          "note": "may have + V3."
        }
      ]
    },
    {
      "id": "b2-05-passive-infinitive-gerund",
      "level": "B2",
      "order": 5,
      "title": "to be done, being done, not doing",
      "topic": "Passive infinitive and gerund; negative gerund",
      "canDo": "Edilgen anlamı fiilimsi biçimlerde de kurabilirim.",
      "covers": [
        "TO.to_be_done",
        "VG.being_VN",
        "VG.not_VG"
      ],
      "concept": {
        "summary": "Fiilimsiler de edilgen olabilir. to'lu biçimde to be + V3, -ing biçiminde being + V3 kullanılır. -ing'in olumsuzunda not, -ing'in önüne gelir: not knowing.",
        "formula": {
          "left": "to be + V3",
          "right": "being + V3 / not + -ing"
        },
        "table": [
          {
            "form": "to'lu edilgen",
            "be": "to be + V3",
            "example": "He wants to be promoted."
          },
          {
            "form": "-ing edilgen",
            "be": "being + V3",
            "example": "She hates being interrupted."
          },
          {
            "form": "olumsuz -ing",
            "be": "not + -ing",
            "example": "Not knowing the way, we asked."
          },
          {
            "form": "gereklilik",
            "be": "to be done",
            "example": "There is work to be done."
          }
        ]
      },
      "examples": [
        {
          "en": "Nobody likes being criticised in public.",
          "tr": "Kimse herkesin önünde eleştirilmekten hoşlanmaz.",
          "note": "being + V3."
        },
        {
          "en": "She hopes to be chosen for the team.",
          "tr": "Takıma seçilmeyi umuyor.",
          "note": "to be + V3."
        },
        {
          "en": "Not having a car, he takes the bus.",
          "tr": "Arabası olmadığı için otobüse biniyor.",
          "note": "not + -ing."
        },
        {
          "en": "These forms need to be signed today.",
          "tr": "Bu formların bugün imzalanması gerekiyor.",
          "note": "need + to be + V3."
        },
        {
          "en": "He apologised for not replying sooner.",
          "tr": "Daha erken cevap vermediği için özür diledi.",
          "note": "Edattan sonra not + -ing."
        }
      ],
      "mistakes": [
        {
          "wrong": "She hates to being interrupted.",
          "right": "She hates being interrupted.",
          "why": "to ile -ing birlikte gelmez."
