          ],
          "answer": 0,
          "note": "not + -ing."
        },
        {
          "type": "choice",
          "text": "The room needs ___ before the guests arrive.",
          "options": [
            "to be cleaned",
            "to clean be",
            "being cleaned to",
            "to be clean"
          ],
          "answer": 0,
