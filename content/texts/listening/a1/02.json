      "order": 8,
      "kind": "listening",
      "title": "Aile fotoğrafı",
      "titleEn": "The Family Photo",
      "minutes": 2,
      "names": ["Burak", "Nur"],
      "speakers": ["Burak", "Nur"],
      "lines": [
        { "who": "Nur", "en": "Is this your family?", "tr": "Bu senin ailen mi?" },
        { "who": "Burak", "en": "Yes. That is my mother and my father.", "tr": "Evet. Bu annem, bu da babam." },
        { "who": "Nur", "en": "Who is the girl with the long hair?", "tr": "Uzun saçlı kız kim?" },
        { "who": "Burak", "en": "My sister. She is a doctor in Ankara.", "tr": "Kız kardeşim. Ankara'da doktor." },
        { "who": "Nur", "en": "And the little boy?", "tr": "Peki küçük çocuk?" },
        { "who": "Burak", "en": "That is me! I was seven years old.", "tr": "O benim! Yedi yaşındaydım." }
      ],
      "glossary": [],
      "questions": [
        { "q": "Who has long hair?", "options": ["His sister", "His mother", "Nur", "Burak"], "answer": 0, "note": "Uzun saçlı kız, kız kardeşi." },
        { "q": "What is his sister's job?", "options": ["Doctor", "Teacher", "Student", "Nurse"], "answer": 0, "note": "\"She is a doctor in Ankara.\"" },
        { "q": "Who is the little boy?", "options": ["Burak", "His brother", "His cousin", "A friend"], "answer": 0, "note": "\"That is me!\"" },
        { "q": "How old was Burak in the photo?", "options": ["Seven", "Ten", "Five", "Seventeen"], "answer": 0, "note": "\"I was seven years old.\"" }
      ]
    },
    {
      "id": "a1-l-09",
      "level": "A1",
      "order": 9,
      "kind": "listening",
      "title": "Doktorda randevu",
      "titleEn": "A Doctor's Appointment",
      "minutes": 2,
      "names": ["Hakan"],
      "speakers": ["Hakan", "Nurse"],
      "lines": [
        { "who": "Hakan", "en": "Hello. I want to see the doctor today.", "tr": "Merhaba. Bugün doktoru görmek istiyorum." },
        { "who": "Nurse", "en": "What is the problem?", "tr": "Sorun nedir?" },
        { "who": "Hakan", "en": "My back hurts and I cannot sleep.", "tr": "Sırtım ağrıyor ve uyuyamıyorum." },
        { "who": "Nurse", "en": "The doctor is free at four o'clock.", "tr": "Doktor saat dörtte müsait." },
        { "who": "Hakan", "en": "That is good. Do I need my card?", "tr": "Bu iyi. Kartım lazım mı?" },
        { "who": "Nurse", "en": "Yes, please bring your card and come early.", "tr": "Evet, lütfen kartınızı getirin ve erken gelin." }
      ],
      "glossary": [],
      "questions": [
        { "q": "What is Hakan's problem?", "options": ["His back hurts", "His head hurts", "He is hot", "He is tired only"], "answer": 0, "note": "\"My back hurts and I cannot sleep.\"" },
        { "q": "When can he see the doctor?", "options": ["At four", "At two", "Tomorrow", "At six"], "answer": 0, "note": "\"The doctor is free at four o'clock.\"" },
        { "q": "What must he bring?", "options": ["His card", "A book", "Money only", "Nothing"], "answer": 0, "note": "\"Please bring your card.\"" },
        { "q": "What else does the nurse say?", "options": ["Come early", "Come late", "Call again", "Bring a friend"], "answer": 0, "note": "\"Come early.\"" }
      ]
    },
    {
      "id": "a1-l-10",
