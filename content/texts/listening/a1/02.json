      "kind": "listening",
      "title": "Markette",
      "titleEn": "At the Shop",
      "minutes": 2,
      "names": ["Leyla"],
      "speakers": ["Leyla", "Shop assistant"],
      "lines": [
        { "who": "Leyla", "en": "Excuse me, do you have red apples?", "tr": "Affedersiniz, kırmızı elma var mı?" },
        { "who": "Shop assistant", "en": "Yes, they are next to the bananas.", "tr": "Evet, muzların yanında." },
        { "who": "Leyla", "en": "Thank you. And where is the milk?", "tr": "Teşekkürler. Süt nerede?" },
        { "who": "Shop assistant", "en": "At the back of the shop, on the left.", "tr": "Dükkânın arkasında, solda." },
        { "who": "Leyla", "en": "Are you open on Sunday?", "tr": "Pazar günü açık mısınız?" },
        { "who": "Shop assistant", "en": "Yes, but we close at six.", "tr": "Evet ama altıda kapatıyoruz." }
      ],
      "glossary": [],
      "questions": [
        { "q": "What does Leyla want first?", "options": ["Red apples", "Bananas", "Milk", "Bread"], "answer": 0, "note": "\"Do you have red apples?\"" },
        { "q": "Where are the apples?", "options": ["Next to the bananas", "At the back", "On the left", "Near the door"], "answer": 0, "note": "\"They are next to the bananas.\"" },
        { "q": "Where is the milk?", "options": ["At the back, on the left", "Next to the apples", "Near the door", "Outside"], "answer": 0, "note": "\"At the back of the shop, on the left.\"" },
        { "q": "When does the shop close on Sunday?", "options": ["At six", "At eight", "It does not open", "At ten"], "answer": 0, "note": "\"We close at six.\"" }
      ]
    },
    {
      "id": "a1-l-07",
      "level": "A1",
      "order": 7,
      "kind": "listening",
      "title": "Hafta sonu planı",
      "titleEn": "Weekend Plans",
      "minutes": 2,
      "names": ["Emre", "Ceren"],
      "speakers": ["Emre", "Ceren"],
      "lines": [
        { "who": "Emre", "en": "What are you doing on Saturday?", "tr": "Cumartesi ne yapıyorsun?" },
        { "who": "Ceren", "en": "Nothing. Why do you ask?", "tr": "Hiçbir şey. Neden soruyorsun?" },
        { "who": "Emre", "en": "We are going to the beach. Come with us.", "tr": "Plaja gidiyoruz. Bizimle gel." },
        { "who": "Ceren", "en": "I would like to. What time?", "tr": "İsterim. Saat kaçta?" },
        { "who": "Emre", "en": "At nine in the morning. We take my car.", "tr": "Sabah dokuzda. Arabamla gidiyoruz." },
        { "who": "Ceren", "en": "Perfect. I will bring some food.", "tr": "Harika. Ben biraz yiyecek getiririm." }
      ],
      "glossary": [
        { "w": "beach", "tr": "plaj, sahil" },
        { "w": "perfect", "tr": "harika, mükemmel" }
      ],
      "questions": [
        { "q": "Where are they going?", "options": ["To the beach", "To the park", "To a cafe", "To the mountains"], "answer": 0, "note": "\"We are going to the beach.\"" },
        { "q": "What time do they leave?", "options": ["At nine", "At ten", "At eight", "At seven"], "answer": 0, "note": "\"At nine in the morning.\"" },
        { "q": "How do they travel?", "options": ["By car", "By bus", "By train", "By taxi"], "answer": 0, "note": "\"We take my car.\"" },
        { "q": "What will Ceren bring?", "options": ["Food", "Music", "A ball", "Nothing"], "answer": 0, "note": "\"I will bring some food.\"" }
      ]
    },
    {
      "id": "a1-l-08",
