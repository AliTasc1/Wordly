      "lines": [
        { "who": "Melis", "en": "Excuse me. I cannot find my bag.", "tr": "Affedersiniz. Çantamı bulamıyorum." },
        { "who": "Officer", "en": "What color is it?", "tr": "Ne renk?" },
        { "who": "Melis", "en": "It is black and very big.", "tr": "Siyah ve çok büyük." },
        { "who": "Officer", "en": "What is in the bag?", "tr": "Çantanın içinde ne var?" },
        { "who": "Melis", "en": "My books, a phone and my keys.", "tr": "Kitaplarım, bir telefon ve anahtarlarım." },
        { "who": "Officer", "en": "Wait here, please. I think we have it.", "tr": "Lütfen burada bekleyin. Sanırım bizde." }
      ],
      "glossary": [],
      "questions": [
        { "q": "What cannot Melis find?", "options": ["Her bag", "Her phone", "Her keys", "Her books"], "answer": 0, "note": "\"I cannot find my bag.\"" },
