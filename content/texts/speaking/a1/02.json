        "What music do you listen to?",
        "Do you play any sport?",
        "What do you not like?"
      ],
      "promptsTr": [
        "Hangi yemekleri seversin?",
        "Hangi müzikleri dinlersin?",
        "Spor yapar mısın?",
        "Neyi sevmezsin?"
      ],
      "usefulPhrases": [
        { "en": "I like fish very much.", "tr": "Balığı çok severim." },
        { "en": "I listen to music every day.", "tr": "Her gün müzik dinlerim." },
        { "en": "I play football on Sundays.", "tr": "Pazar günleri futbol oynarım." },
        { "en": "I do not like coffee.", "tr": "Kahveyi sevmem." },
        { "en": "What about you?", "tr": "Peki ya sen?" }
      ],
      "glossary": []
    },
