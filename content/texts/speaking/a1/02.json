        "Bir poşet iste.",
        "Öde ve hoşça kal de."
      ],
      "usefulPhrases": [
        { "en": "I would like some bread, please.", "tr": "Biraz ekmek istiyorum lütfen." },
        { "en": "How much are the eggs?", "tr": "Yumurtalar ne kadar?" },
        { "en": "Can I have a bag?", "tr": "Bir poşet alabilir miyim?" },
        { "en": "Here you are.", "tr": "Buyurun." },
        { "en": "Bye, have a nice day.", "tr": "Hoşça kalın, iyi günler." }
