 "say--verb": { "tr": "söylemek, demek", "def": "to speak words", "ex": "Say it again, please.", "exTr": "Tekrar söyle, lütfen." },
 "too--adv": { "tr": "de/da, çok fazla", "def": "also, or more than is good", "ex": "I am tired too.", "exTr": "Ben de yorgunum." },
