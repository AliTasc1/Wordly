 "about--adv": { "tr": "yaklaşık", "def": "a little more or less than a number", "ex": "I sleep about eight hours.", "exTr": "Yaklaşık sekiz saat uyurum." },
 "now--adv": { "tr": "şimdi", "def": "at this time", "ex": "I am busy now.", "exTr": "Şu an meşgulüm." },
 "come--verb": { "tr": "gelmek", "def": "to move to the place where the speaker is", "ex": "Come with me.", "exTr": "Benimle gel." },
 "well--adj": { "tr": "iyi, sağlıklı", "def": "healthy, not ill", "ex": "I am well, thank you.", "exTr": "İyiyim, teşekkürler." },
 "well--adv": { "tr": "iyi bir şekilde", "def": "in a good way", "ex": "She sings well.", "exTr": "O iyi şarkı söyler." },
 "how--adv": { "tr": "nasıl", "def": "used to ask about the way something happens", "ex": "How do you go to work?", "exTr": "İşe nasıl gidiyorsun?" },
 "want--verb": { "tr": "istemek", "def": "to feel that you would like to have something", "ex": "I want a new phone.", "exTr": "Yeni bir telefon istiyorum." },
 "think--verb": { "tr": "düşünmek, sanmak", "def": "to have an opinion or an idea", "ex": "I think this film is good.", "exTr": "Bu filmin iyi olduğunu düşünüyorum." },
 "see--verb": { "tr": "görmek", "def": "to notice something with your eyes", "ex": "I can see the sea.", "exTr": "Denizi görebiliyorum." },
