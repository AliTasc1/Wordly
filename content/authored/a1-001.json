 "where--adv": { "tr": "nerede, nereye", "def": "used to ask about a place", "ex": "Where is my key?", "exTr": "Anahtarım nerede?" },
 "take--verb": { "tr": "almak, götürmek", "def": "to get something in your hand, or to carry it with you", "ex": "Take your umbrella.", "exTr": "Şemsiyeni al." },
