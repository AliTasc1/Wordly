 "think--verb": { "tr": "düşünmek, sanmak", "def": "Bir konuda fikir sahibi olmak.", "ex": "I think this film is good.", "exTr": "Bu filmin iyi olduğunu düşünüyorum." },
 "see--verb": { "tr": "görmek", "def": "Gözle fark etmek, bakıp algılamak.", "ex": "I can see the sea.", "exTr": "Denizi görebiliyorum." },
 "good--adj": { "tr": "iyi", "def": "Kaliteli ya da hoşa giden.", "ex": "This is a good book.", "exTr": "Bu iyi bir kitap." },
