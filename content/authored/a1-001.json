 "too--adv": { "tr": "de/da, çok fazla", "def": "Ayrıca; ya da gereğinden fazla.", "ex": "I am tired too.", "exTr": "Ben de yorgunum." },
 "way--noun": { "tr": "yol, yöntem", "def": "Bir yere giden yol ya da bir işi yapma biçimi.", "ex": "This is the way to the station.", "exTr": "İstasyona giden yol bu." },
 "down--adv": { "tr": "aşağı, aşağıda", "def": "Daha alçak bir yere doğru ya da orada.", "ex": "Please sit down.", "exTr": "Lütfen otur." },
 "make--verb": { "tr": "yapmak, üretmek", "def": "Bir şeyi üretmek, ortaya çıkarmak.", "ex": "I make breakfast every morning.", "exTr": "Her sabah kahvaltı hazırlarım." },
 "very--adv": { "tr": "çok", "def": "Bir sıfatı güçlendirmek için kullanılır.", "ex": "The weather is very cold.", "exTr": "Hava çok soğuk." },
