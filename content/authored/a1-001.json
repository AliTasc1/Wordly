 "well--adv": { "tr": "iyi bir şekilde", "def": "Bir işi iyi yaparak.", "ex": "She sings well.", "exTr": "O iyi şarkı söyler." },
 "how--adv": { "tr": "nasıl", "def": "Bir şeyin ne şekilde olduğunu sormak için kullanılır.", "ex": "How do you go to work?", "exTr": "İşe nasıl gidiyorsun?" },
