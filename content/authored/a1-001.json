 "very--adv": { "tr": "çok", "def": "used to make an adjective stronger", "ex": "The weather is very cold.", "exTr": "Hava çok soğuk." },
 "never--adv": { "tr": "asla, hiç", "def": "not at any time", "ex": "I never drink tea.", "exTr": "Hiç çay içmem." },
 "only--adj": { "tr": "tek", "def": "with no others of the same kind", "ex": "She is my only sister.", "exTr": "O benim tek kız kardeşim." },
 "only--adv": { "tr": "sadece, yalnızca", "def": "and nothing or nobody else", "ex": "I have only one question.", "exTr": "Sadece bir sorum var." },
 "people--noun": { "tr": "insanlar", "def": "more than one person", "ex": "Many people live here.", "exTr": "Burada çok insan yaşıyor." },
 "little--adj": { "tr": "küçük, az", "def": "small in size or amount", "ex": "We have a little garden.", "exTr": "Küçük bir bahçemiz var." },
 "little--adv": { "tr": "az", "def": "not much", "ex": "I sleep very little.", "exTr": "Çok az uyurum." },
 "please--adv": { "tr": "lütfen", "def": "used to ask for something politely", "ex": "Open the window, please.", "exTr": "Pencereyi aç, lütfen." },
 "love--noun": { "tr": "sevgi, aşk", "def": "a very strong feeling of liking someone", "ex": "Her love for music is big.", "exTr": "Müziğe olan sevgisi büyük." },
 "love--verb": { "tr": "sevmek", "def": "to like someone or something very much", "ex": "I love my family.", "exTr": "Ailemi seviyorum." },
 "mean--verb": { "tr": "anlamına gelmek, kastetmek", "def": "to have a particular meaning", "ex": "What does this word mean?", "exTr": "Bu kelime ne anlama geliyor?" },
 "sorry--adj": { "tr": "üzgün", "def": "used to say that you feel bad about something", "ex": "I am sorry, I am late.", "exTr": "Üzgünüm, geç kaldım." },
 "give--verb": { "tr": "vermek", "def": "to put something in someone's hand", "ex": "Give me the salt, please.", "exTr": "Tuzu bana ver, lütfen." },
 "off--adj": { "tr": "kapalı", "def": "not working or not switched on", "ex": "The lights are off.", "exTr": "Işıklar kapalı." },
 "thank--verb": { "tr": "teşekkür etmek", "def": "to tell someone that you are grateful", "ex": "I thank you for your help.", "exTr": "Yardımın için sana teşekkür ederim." },
 "much--adv": { "tr": "çok", "def": "a large amount", "ex": "I do not eat much.", "exTr": "Çok yemem." },
 "sure--adj": { "tr": "emin", "def": "certain that something is true", "ex": "I am sure about the answer.", "exTr": "Cevaptan eminim." },
 "thing--noun": { "tr": "şey, nesne", "def": "an object that you do not name", "ex": "What is this thing?", "exTr": "Bu şey ne?" }
