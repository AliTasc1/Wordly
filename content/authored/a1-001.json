 "people--noun": { "tr": "insanlar", "def": "Birden fazla kişi.", "ex": "Many people live here.", "exTr": "Burada çok insan yaşıyor." },
 "little--adj": { "tr": "küçük, az", "def": "Boyutu ya da miktarı küçük olan.", "ex": "We have a little garden.", "exTr": "Küçük bir bahçemiz var." },
 "little--adv": { "tr": "az", "def": "Fazla değil, az miktarda.", "ex": "I sleep very little.", "exTr": "Çok az uyurum." },
 "please--adv": { "tr": "lütfen", "def": "Bir şeyi kibarca istemek için kullanılır.", "ex": "Open the window, please.", "exTr": "Pencereyi aç, lütfen." },
 "love--noun": { "tr": "sevgi, aşk", "def": "Birine ya da bir şeye duyulan çok güçlü sevgi.", "ex": "This song is about love.", "exTr": "Bu şarkı aşk hakkında." },
 "love--verb": { "tr": "sevmek", "def": "Birini ya da bir şeyi çok sevmek.", "ex": "I love my family.", "exTr": "Ailemi seviyorum." },
 "mean--verb": { "tr": "anlamına gelmek, kastetmek", "def": "Belirli bir anlam taşımak.", "ex": "What does this word mean?", "exTr": "Bu kelime ne anlama geliyor?" },
 "sorry--adj": { "tr": "üzgün", "def": "Bir durumdan dolayı üzüntü duyduğunu belirtir.", "ex": "I am sorry, I am late.", "exTr": "Üzgünüm, geç kaldım." },
 "give--verb": { "tr": "vermek", "def": "Bir şeyi birinin eline ya da sahipliğine bırakmak.", "ex": "Give me the salt, please.", "exTr": "Tuzu bana ver, lütfen." },
 "off--adj": { "tr": "kapalı", "def": "Çalışmayan, açık olmayan.", "ex": "The lights are off.", "exTr": "Işıklar kapalı." },
 "thank--verb": { "tr": "teşekkür etmek", "def": "Birine minnettar olduğunu söylemek.", "ex": "Thank you for your help.", "exTr": "Yardımın için teşekkürler." },
 "much--adv": { "tr": "çok", "def": "Büyük miktarda.", "ex": "I do not eat much.", "exTr": "Çok yemem." },
 "sure--adj": { "tr": "emin", "def": "Bir şeyin doğruluğundan kuşku duymayan.", "ex": "I am sure about the answer.", "exTr": "Cevaptan eminim." },
 "thing--noun": { "tr": "şey, nesne", "def": "Adını koymadığın bir nesne.", "ex": "What is this thing?", "exTr": "Bu şey ne?" }
}
