 },
 "no--adv": { "tr": "hayır", "def": "Olumsuz cevap vermek için kullanılır.", "ex": "No, I am not tired.", "exTr": "Hayır, yorgun değilim." },
 "not--adv": { "tr": "değil, -me/-ma", "def": "Bir cümleyi olumsuz yapar.", "ex": "She is not at home.", "exTr": "O evde değil." },
 "know--verb": { "tr": "bilmek, tanımak", "def": "Bir şeyi zihninde bilgi olarak taşımak.", "ex": "I know her name.", "exTr": "Onun adını biliyorum." },
 "just--adv": { "tr": "sadece, az önce", "def": "Yalnızca; ya da çok kısa süre önce.", "ex": "I just want some water.", "exTr": "Sadece biraz su istiyorum." },
 "there--adv": { "tr": "orada, oraya", "def": "Konuşandan uzaktaki yerde ya da o yere.", "ex": "Your bag is over there.", "exTr": "Çantan şurada." },
 "here--adv": { "tr": "burada, buraya", "def": "Konuşanın bulunduğu yerde ya da o yere.", "ex": "Come here, please.", "exTr": "Buraya gel, lütfen." },
