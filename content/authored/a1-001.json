 "know--verb": { "tr": "bilmek, tanımak", "def": "to have information about something in your mind", "ex": "I know her name.", "exTr": "Onun adını biliyorum." },
 "just--adv": { "tr": "sadece, az önce", "def": "only, or a very short time ago", "ex": "I just want some water.", "exTr": "Sadece biraz su istiyorum." },
 "there--adv": { "tr": "orada, oraya", "def": "in or to that place", "ex": "Your bag is over there.", "exTr": "Çantan şurada." },
