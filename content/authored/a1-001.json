 "back--adv": { "tr": "geri", "def": "Önceki yere ya da duruma dönerek.", "ex": "I come back at six.", "exTr": "Altıda geri dönerim." },
 "back--noun": { "tr": "sırt, arka", "def": "Vücudun arka kısmı ya da bir şeyin arka tarafı.", "ex": "My back hurts.", "exTr": "Sırtım ağrıyor." },
 "look--noun": { "tr": "bakış", "def": "Bir şeye bakma eylemi.", "ex": "Take a look at this photo.", "exTr": "Şu fotoğrafa bir bak." },
