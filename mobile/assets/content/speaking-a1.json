  "minutes": 3,
  "situation": "You do not feel well. Tell the doctor about the problem.",
  "situationTr": "Kendini iyi hissetmiyorsun. Doktora sorunu anlat.",
  "prompts": [
   "Say what hurts.",
   "Say when it started.",
   "Ask what you must do.",
   "Ask about medicine."
  ],
  "promptsTr": [
   "Neren ağrıyor söyle.",
   "Ne zaman başladığını söyle.",
   "Ne yapman gerektiğini sor.",
   "İlacı sor."
  ],
  "usefulPhrases": [
   {
    "en": "My head hurts.",
    "tr": "Başım ağrıyor."
   },
   {
    "en": "It started on Monday.",
    "tr": "Pazartesi başladı."
   },
   {
    "en": "What must I do?",
    "tr": "Ne yapmalıyım?"
   },
   {
    "en": "Do I need medicine?",
    "tr": "İlaca ihtiyacım var mı?"
   },
   {
    "en": "Thank you, doctor.",
    "tr": "Teşekkürler doktor."
   }
  ],
  "glossary": [
