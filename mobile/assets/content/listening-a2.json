[
 {
  "id": "a2-l-01",
  "level": "A2",
  "order": 1,
  "kind": "listening",
  "title": "Tren bileti",
  "titleEn": "Buying a Train Ticket",
  "minutes": 3,
  "names": [
   "Konya"
  ],
  "speakers": [
   "Traveler",
   "Clerk"
  ],
  "lines": [
   {
    "who": "Traveler",
    "en": "Good afternoon. I would like a ticket to Konya.",
    "tr": "İyi günler. Konya'ya bir bilet istiyorum."
   },
   {
    "who": "Clerk",
    "en": "Single or return?",
    "tr": "Tek yön mü gidiş dönüş mü?"
   },
   {
    "who": "Traveler",
    "en": "Return, please. I am coming back on Sunday.",
    "tr": "Gidiş dönüş lütfen. Pazar günü dönüyorum."
   },
   {
    "who": "Clerk",
    "en": "There is a train at ten and another at two.",
    "tr": "Onda bir tren var, bir de ikide."
   },
   {
    "who": "Traveler",
    "en": "I will take the one at ten. How long is the journey?",
    "tr": "Ondakini alayım. Yolculuk ne kadar sürüyor?"
   },
   {
    "who": "Clerk",
    "en": "About four hours. Do you want a window seat?",
    "tr": "Yaklaşık dört saat. Pencere kenarı ister misiniz?"
   },
   {
    "who": "Traveler",
    "en": "Yes, please. Can I pay by card?",
    "tr": "Evet lütfen. Kartla ödeyebilir miyim?"
   },
   {
    "who": "Clerk",
    "en": "Of course. Your train leaves from platform three.",
    "tr": "Tabii. Treniniz üç numaralı perondan kalkıyor."
   }
  ],
  "glossary": [
   {
    "w": "single",
    "tr": "tek yön (bilet)"
   },
   {
    "w": "return",
    "tr": "gidiş dönüş"
   },
   {
    "w": "platform",
    "tr": "peron"
   }
  ],
  "questions": [
   {
    "q": "What kind of ticket does the traveler buy?",
    "options": [
     "Monthly",
     "Return",
     "Weekly",
     "Single"
    ],
    "answer": 1,
    "note": "\"Return, please.\""
   },
   {
    "q": "Which train does she choose?",
    "options": [
     "The one at four",
     "The one at three",
     "The one at two",
     "The one at ten"
    ],
    "answer": 3,
    "note": "\"I will take the one at ten.\""
   },
   {
    "q": "How long is the journey?",
    "options": [
     "About two hours",
     "Three hours",
     "About four hours",
     "Ten hours"
    ],
    "answer": 2,
    "note": "\"About four hours.\""
   },
   {
    "q": "How does she pay?",
    "options": [
     "By phone",
     "In cash",
     "She does not pay",
     "By card"
    ],
    "answer": 3,
    "note": "\"Can I pay by card?\" — \"Of course.\""
   },
   {
    "q": "Which platform is the train?",
    "options": [
     "Four",
     "Ten",
     "Three",
     "Two"
    ],
    "answer": 2,
    "note": "\"Your train leaves from platform three.\""
   }
  ]
 },
 {
  "id": "a2-l-02",
  "level": "A2",
  "order": 2,
  "kind": "listening",
  "title": "İş görüşmesi öncesi",
  "titleEn": "Before the Interview",
  "minutes": 3,
  "names": [
   "Defne",
   "Umut"
  ],
  "speakers": [
   "Defne",
   "Umut"
  ],
  "lines": [
   {
    "who": "Umut",
    "en": "You look nervous. Is everything all right?",
    "tr": "Gergin görünüyorsun. Her şey yolunda mı?"
   },
   {
    "who": "Defne",
    "en": "I have an interview tomorrow morning.",
    "tr": "Yarın sabah bir iş görüşmem var."
   },
   {
    "who": "Umut",
    "en": "That is great news. What is the job?",
    "tr": "Bu harika bir haber. İş ne?"
   },
   {
    "who": "Defne",
    "en": "It is in a design studio. I sent my application in May.",
    "tr": "Bir tasarım stüdyosunda. Başvurumu mayısta göndermiştim."
   },
   {
    "who": "Umut",
    "en": "Have you prepared your answers?",
    "tr": "Cevaplarını hazırladın mı?"
   },
   {
    "who": "Defne",
    "en": "Some of them. I am worried about the salary question.",
    "tr": "Bir kısmını. Maaş sorusundan endişeliyim."
   },
   {
    "who": "Umut",
    "en": "Just say what you need and wait. Do not apologize.",
    "tr": "Ne istediğini söyle ve bekle. Özür dileme."
   },
   {
    "who": "Defne",
    "en": "That is good advice. Thank you.",
    "tr": "İyi bir tavsiye. Teşekkürler."
   }
  ],
  "glossary": [
   {
    "w": "nervous",
    "tr": "gergin"
   },
   {
