    "options": [
     "The wrong food arrived",
     "The table is dirty",
     "The bill is wrong",
     "The food is cold"
    ],
    "answer": 0,
    "note": "\"This is not what I ordered.\""
   },
   {
    "q": "What did the customer order?",
    "options": [
     "Chicken soup",
     "Coffee",
     "Fish",
     "Salad"
    ],
    "answer": 0,
    "note": "\"Chicken soup, but this is fish.\""
   },
   {
    "q": "How long will the new dish take?",
    "options": [
     "Two minutes",
     "Five minutes",
     "An hour",
     "Fifteen minutes"
    ],
    "answer": 1,
    "note": "\"Five minutes.\""
   },
   {
    "q": "Why is the customer worried about the time?",
    "options": [
     "The restaurant closes",
     "They are in a hurry",
     "They are hungry",
     "They have a train"
    ],
    "answer": 1,
    "note": "\"We are in a hurry.\""
   },
   {
    "q": "What does the waiter offer?",
    "options": [
     "A free meal",
