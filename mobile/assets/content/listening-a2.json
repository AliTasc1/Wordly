 {
  "id": "a2-l-03",
  "level": "A2",
  "order": 3,
  "kind": "listening",
  "title": "Komşu şikâyeti",
  "titleEn": "A Complaint",
  "minutes": 3,
  "names": [
   "Gul"
  ],
  "speakers": [
   "Gul",
   "Neighbor"
  ],
  "lines": [
   {
    "who": "Gul",
    "en": "Excuse me, can I talk to you for a minute?",
    "tr": "Affedersiniz, bir dakika konuşabilir miyiz?"
   },
   {
    "who": "Neighbor",
    "en": "Of course. Is there a problem?",
    "tr": "Tabii. Bir sorun mu var?"
   },
   {
    "who": "Gul",
    "en": "Your music was very loud last night.",
    "tr": "Dün gece müziğiniz çok yüksekti."
   },
   {
    "who": "Neighbor",
    "en": "I am really sorry. We had a birthday party.",
    "tr": "Gerçekten özür dilerim. Doğum günü partimiz vardı."
   },
   {
    "who": "Gul",
    "en": "I understand, but my son has school in the morning.",
    "tr": "Anlıyorum ama oğlumun sabah okulu var."
   },
   {
    "who": "Neighbor",
    "en": "You are right. Next time I will tell you before.",
    "tr": "Haklısınız. Bir dahaki sefere size önceden söylerim."
   },
   {
    "who": "Gul",
    "en": "Thank you. That would help a lot.",
    "tr": "Teşekkürler. Bu çok yardımcı olur."
   },
   {
    "who": "Neighbor",
    "en": "And we will stop the music at eleven.",
    "tr": "Ayrıca müziği on birde keseriz."
   }
  ],
  "glossary": [
   {
    "w": "loud",
    "tr": "yüksek sesli"
   },
   {
    "w": "neighbor",
    "tr": "komşu"
   }
  ],
  "questions": [
   {
    "q": "What is Gul's complaint?",
    "options": [
     "The music was too loud",
     "The lights were on",
     "There was a bad smell",
     "The door was open"
    ],
    "answer": 0,
    "note": "\"Your music was very loud last night.\""
   },
   {
    "q": "Why was there music?",
    "options": [
     "A wedding",
     "A birthday party",
     "A concert",
     "A holiday"
    ],
    "answer": 1,
    "note": "\"We had a birthday party.\""
   },
   {
    "q": "Why is this a problem for Gul?",
    "options": [
     "Her son has school in the morning",
     "She hates music",
     "She works at night",
     "She is ill"
    ],
    "answer": 0,
    "note": "\"My son has school in the morning.\""
   },
   {
    "q": "What will the neighbor do next time?",
    "options": [
     "Move the party",
     "Tell her before",
     "Invite her",
     "Play quieter music only"
    ],
    "answer": 1,
    "note": "\"Next time I will tell you before.\""
   },
   {
    "q": "When will they stop the music?",
    "options": [
     "At nine",
     "At eleven",
     "At midnight",
     "At ten"
    ],
    "answer": 1,
    "note": "\"We will stop the music at eleven.\""
   }
  ]
 },
 {
