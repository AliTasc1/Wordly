  "lines": [
   {
    "who": "Customer",
    "en": "Excuse me, this is not what I ordered.",
    "tr": "Affedersiniz, bu sipariş ettiğim şey değil."
   },
   {
    "who": "Waiter",
    "en": "I am very sorry. What did you order?",
    "tr": "Çok özür dilerim. Ne sipariş etmiştiniz?"
   },
   {
    "who": "Customer",
    "en": "Chicken soup, but this is fish.",
    "tr": "Tavuk çorbası ama bu balık."
   },
   {
    "who": "Waiter",
    "en": "You are right. I will change it immediately.",
    "tr": "Haklısınız. Hemen değiştireceğim."
   },
   {
    "who": "Customer",
    "en": "How long will it take? We are in a hurry.",
    "tr": "Ne kadar sürer? Acelemiz var."
   },
   {
    "who": "Waiter",
    "en": "Five minutes. The soup is already hot.",
    "tr": "Beş dakika. Çorba zaten hazır."
   },
   {
    "who": "Customer",
    "en": "All right, thank you.",
    "tr": "Tamam, teşekkürler."
   },
   {
    "who": "Waiter",
    "en": "And your coffee will be free today.",
    "tr": "Ayrıca kahveniz bugün bizden."
   }
  ],
  "glossary": [
