   },
   {
    "w": "application",
    "tr": "başvuru"
   },
   {
    "w": "salary",
    "tr": "maaş"
   },
   {
    "w": "apologize",
    "tr": "özür dilemek"
   },
   {
    "w": "studio",
    "tr": "stüdyo"
   }
  ],
  "questions": [
   {
    "q": "Why is Defne nervous?",
    "options": [
     "She has an interview tomorrow",
     "She lost her job",
     "She is moving",
     "She is ill"
    ],
    "answer": 0,
    "note": "\"I have an interview tomorrow morning.\""
   },
   {
    "q": "Where is the job?",
    "options": [
     "In a school",
     "In a hospital",
     "In a shop",
     "In a design studio"
    ],
    "answer": 3,
    "note": "\"It is in a design studio.\""
   },
   {
    "q": "When did she apply?",
    "options": [
     "Yesterday",
     "In March",
     "In May",
     "Last week"
    ],
    "answer": 2,
    "note": "\"I sent my application in May.\""
   },
   {
    "q": "What worries her most?",
    "options": [
     "The time",
     "The salary question",
     "The journey",
     "Her clothes"
    ],
    "answer": 1,
    "note": "\"I am worried about the salary question.\""
   },
   {
    "q": "What does Umut advise?",
    "options": [
     "Say what you need and wait",
     "Ask for less",
