  "names": [
   "Mert",
   "Sena"
  ],
  "speakers": [
   "Mert",
   "Sena"
  ],
  "lines": [
   {
    "who": "Mert",
    "en": "Hello Sena. Are you at home?",
    "tr": "Merhaba Sena. Evde misin?"
   },
   {
    "who": "Sena",
    "en": "No, I am at the supermarket. Why?",
    "tr": "Hayır, süpermarketteyim. Neden?"
   },
   {
    "who": "Mert",
    "en": "We have no bread. Can you buy some?",
    "tr": "Ekmeğimiz yok. Biraz alabilir misin?"
   },
   {
    "who": "Sena",
    "en": "Yes, of course. Do we need milk too?",
    "tr": "Evet, tabii. Süte de ihtiyacımız var mı?"
   },
   {
    "who": "Mert",
    "en": "No, we have milk. Only bread.",
    "tr": "Hayır, sütümüz var. Sadece ekmek."
   },
   {
    "who": "Sena",
    "en": "All right. I am coming home in twenty minutes.",
    "tr": "Tamam. Yirmi dakikaya eve geliyorum."
   }
  ],
  "glossary": [],
  "questions": [
   {
    "q": "Where is Sena?",
    "options": [
     "At the supermarket",
     "At school",
     "At work",
     "At home"
    ],
    "answer": 0,
    "note": "\"I am at the supermarket.\""
   },
   {
    "q": "What must she buy?",
    "options": [
     "Bread",
     "Nothing",
     "Milk",
     "Bread and milk"
    ],
    "answer": 0,
    "note": "\"Only bread.\""
   },
   {
    "q": "Do they need milk?",
    "options": [
     "No, they have milk",
     "Mert does not know",
     "Yes, two bottles",
     "Yes, one bottle"
    ],
    "answer": 0,
    "note": "\"No, we have milk.\""
   },
   {
    "q": "When is Sena coming home?",
    "options": [
     "In two minutes",
     "Tomorrow",
     "In an hour",
     "In twenty minutes"
    ],
    "answer": 3,
    "note": "\"I am coming home in twenty minutes.\""
   }
  ]
 },
