  "order": 1,
  "kind": "listening",
  "title": "Kafede sipariş",
  "titleEn": "Ordering in a Cafe",
  "minutes": 2,
  "names": [
   "Ali"
  ],
  "speakers": [
   "Waiter",
   "Ali"
  ],
  "lines": [
   {
    "who": "Waiter",
    "en": "Good morning. What would you like?",
    "tr": "Günaydın. Ne alırsınız?"
   },
   {
    "who": "Ali",
    "en": "A tea, please. And a piece of cake.",
    "tr": "Bir çay lütfen. Bir de bir dilim kek."
   },
   {
    "who": "Waiter",
    "en": "Chocolate cake or apple cake?",
    "tr": "Çikolatalı kek mi elmalı kek mi?"
   },
   {
    "who": "Ali",
    "en": "Apple, please. How much is it?",
    "tr": "Elmalı lütfen. Ne kadar?"
   },
   {
    "who": "Waiter",
    "en": "Sixty. Do you want it here or outside?",
    "tr": "Altmış. Burada mı olsun dışarıda mı?"
   },
   {
    "who": "Ali",
    "en": "Outside, please. Thank you.",
    "tr": "Dışarıda lütfen. Teşekkürler."
   }
  ],
  "glossary": [],
  "questions": [
   {
    "q": "What does Ali order to drink?",
    "options": [
     "Coffee",
     "Milk",
     "Water",
     "Tea"
    ],
    "answer": 3,
    "note": "\"A tea, please.\""
   },
   {
    "q": "Which cake does he choose?",
    "options": [
     "Both",
     "Apple",
     "Chocolate",
     "No cake"
    ],
    "answer": 1,
    "note": "\"Apple, please.\""
   },
   {
    "q": "What is the price?",
    "options": [
     "Sixty",
     "Sixteen",
     "Seventy",
     "Six"
    ],
    "answer": 0,
    "note": "\"Sixty.\""
   },
   {
    "q": "Where does Ali want to sit?",
    "options": [
     "Outside",
     "He does not say",
     "At the window",
     "Inside"
    ],
    "answer": 0,
    "note": "\"Outside, please.\""
   }
  ]
 },
 {
  "id": "a1-l-02",
  "level": "A1",
  "order": 2,
  "kind": "listening",
  "title": "Yol sorma",
  "titleEn": "Asking the Way",
  "minutes": 2,
  "names": [
   "Ece"
  ],
  "speakers": [
   "Ece",
   "Man"
  ],
  "lines": [
   {
    "who": "Ece",
    "en": "Excuse me. Where is the bus station?",
    "tr": "Affedersiniz. Otobüs durağı nerede?"
   },
   {
    "who": "Man",
    "en": "Go down this street and turn left.",
    "tr": "Bu sokaktan aşağı inin ve sola dönün."
   },
   {
    "who": "Ece",
    "en": "Is it far?",
    "tr": "Uzak mı?"
   },
   {
    "who": "Man",
    "en": "No, five minutes. It is next to the bank.",
    "tr": "Hayır, beş dakika. Bankanın yanında."
   },
   {
    "who": "Ece",
    "en": "Thank you very much.",
    "tr": "Çok teşekkür ederim."
   },
   {
    "who": "Man",
    "en": "You are welcome. Have a good day.",
    "tr": "Rica ederim. İyi günler."
   }
  ],
  "glossary": [
   {
    "w": "far",
    "tr": "uzak"
   }
  ],
  "questions": [
   {
    "q": "What is Ece looking for?",
    "options": [
     "The bank",
     "A street",
     "The bus station",
     "A shop"
    ],
    "answer": 2,
    "note": "\"Where is the bus station?\""
   },
   {
    "q": "Which way must she turn?",
    "options": [
     "She must go straight",
     "Right",
     "Left",
     "Back"
    ],
    "answer": 2,
    "note": "\"Turn left.\""
   },
   {
    "q": "How long does it take?",
    "options": [
     "An hour",
     "Fifteen minutes",
     "Five minutes",
     "Two minutes"
    ],
    "answer": 2,
    "note": "\"No, five minutes.\""
   },
   {
    "q": "What is next to the bus station?",
    "options": [
     "A bank",
     "A cafe",
     "A school",
     "A park"
    ],
    "answer": 0,
    "note": "\"It is next to the bank.\""
   }
  ]
 },
 {
  "id": "a1-l-03",
  "level": "A1",
  "order": 3,
  "kind": "listening",
  "title": "Telefonda",
  "titleEn": "On the Phone",
