{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Testler Node'un kendi çalıştırıcısıyla koşuyor, uygulama kodu React
    // Native'le. Node tipleri yalnızca burada açık: uygulama tarafına
    // karışsalar `Buffer`, `process`, `fetch` gibi telefonda var olmayan
    // şeyler derleyicide geçerli görünürdü.
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts"]
}
